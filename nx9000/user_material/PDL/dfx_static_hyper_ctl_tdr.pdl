iProcsForModule dfx_static_hyper_ctl_tdr
iProc dfx_sa_hyper_cfg {} {
   iWrite dfx_mode_tdr 0b1
   iWrite dfx_hyper_reserve_ctl_tdr 0b00000000000000000000000000011010
   iWrite dfx_scan_mode_tdr 0b1
   iWrite dfx_sa_mode_tdr 0b1
   iWrite dfx_rst_tdr_n_tdr 0b1
   iWrite dfx_hyper_ctl_ff_init_tdr 0b0
   iApply
   iRunLoop 10 -tck
   iWrite dfx_hyper_ctl_ff_init_tdr 0b1
   iApply
}

