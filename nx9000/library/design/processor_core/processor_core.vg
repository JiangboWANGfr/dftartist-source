module M_RTLSIM_INCR_16(cout, out_15, out_14, out_13, out_12, out_11, out_10, out_9, 
                        out_8, out_7, out_6, out_5, out_4, out_3, out_2, out_1, 
                        out_0, in_15, in_14, in_13, in_12, in_11, in_10, in_9, 
                        in_8, in_7, in_6, in_5, in_4, in_3, in_2, in_1, in_0, cin);
  input  in_15, in_14, in_13, in_12, in_11, in_10, in_9, in_8, in_7, in_6, 
         in_5, in_4, in_3, in_2, in_1, in_0, cin;
  output cout, out_15, out_14, out_13, out_12, out_11, out_10, out_9, out_8, 
         out_7, out_6, out_5, out_4, out_3, out_2, out_1, out_0;

