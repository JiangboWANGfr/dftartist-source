module M_RTLSIM_AND_16(Z, in1, in2, in3, in4, in5, in6, in7, in8, in9, in10, in11, 
                       in12, in13, in14, in15, in16);
  input  in1, in2, in3, in4, in5, in6, in7, in8, in9, in10, in11, in12, in13, 
         in14, in15, in16;
  output Z;

  wire rtlcN0, rtlcN1, rtlcN2, rtlcN3;

  RTLC_AND4 rtlcm_0(
      .Z(rtlcN0), .A(in1), .B(in2), .C(in3), .D(in4)
