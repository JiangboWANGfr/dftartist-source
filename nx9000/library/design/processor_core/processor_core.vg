module omsp_sync_reset(rst_s, clk, rst_a);
  input  clk, rst_a;
  output rst_s;

  wire [1:0] data_sync;
  wire rtlcClkX, rtlcXXX;
  supply0 rtlcVss;
  supply1 rtlcVcc;

  RTLC_BUF rtlc3_0(
      .Z(rst_s), .A(data_sync[1])
  );
  RTLC_FDP rtlcreg_data_sync_1(
      .Q(data_sync[1]), .D(data_sync[0]), .CP(clk), .PRE(rst_a)
  );
  RTLC_FDP rtlcreg_data_sync_0(
      .Q(data_sync[0]), .D(1'b0), .CP(clk), .PRE(rst_a)
  );
endmodule

