module omsp_dbg(dbg_cpu_reset, dbg_freeze, dbg_halt_cmd, dbg_i2c_sda_out, dbg_mem_addr, 
                dbg_mem_dout, dbg_mem_en, dbg_mem_wr, dbg_reg_wr, dbg_uart_txd, 
                cpu_en_s, cpu_id, cpu_nr_inst, cpu_nr_total, dbg_clk, dbg_en_s, 
                dbg_halt_st, dbg_i2c_addr, dbg_i2c_broadcast, dbg_i2c_scl, dbg_i2c_sda_in, 
                dbg_mem_din, dbg_reg_din, dbg_rst, dbg_uart_rxd, decode_noirq, 
                eu_mab, eu_mb_en, eu_mb_wr, fe_mdb_in, pc, puc_pnd_set);
  input  [31:0] cpu_id;
  input  [15:0] dbg_mem_din, dbg_reg_din, eu_mab, fe_mdb_in, pc;
  input  [7:0] cpu_nr_inst, cpu_nr_total;
  input  [6:0] dbg_i2c_addr, dbg_i2c_broadcast;
  input  [1:0] eu_mb_wr;
  input  cpu_en_s, dbg_clk, dbg_en_s, dbg_halt_st, dbg_i2c_scl, dbg_i2c_sda_in, 
         dbg_rst, dbg_uart_rxd, decode_noirq, eu_mb_en, puc_pnd_set;
  output [15:0] dbg_mem_addr, dbg_mem_dout;
  output [1:0] dbg_mem_wr;
  output dbg_cpu_reset, dbg_freeze, dbg_halt_cmd, dbg_i2c_sda_out, dbg_mem_en, 
         dbg_reg_wr, dbg_uart_txd;

  wire [24:0] reg_dec, reg_wr, reg_rd;
  wire [15:0] dbg_din, brk0_dout, brk1_dout, brk2_dout, brk3_dout, cpu_nr, 
              mem_data, mem_addr, dbg_mem_din_bw, mem_cnt, mem_addr_inc, 
              mem_cnt_dec, cpu_id_lo_rd, cpu_id_hi_rd, cpu_ctl_rd, cpu_stat_rd, 
              mem_ctl_rd, mem_data_rd, mem_addr_rd, mem_cnt_rd, cpu_nr_rd, 
              dbg_dout, rtlc0n134, rtlc0n154, rtlc0n346, rtlc0n349, rtlc0n352, 
              rtlc0n355, rtlc0n358, rtlc0n361, rtlc0n364, rtlc0n367, rtlc0n370, 
              rtlc0n373, rtlc0n376, rtlc0n424, rtlc19n19, rtlc22n19;
  wire [7:0] cpu_ctl_full, cpu_stat_full, mem_ctl_full;
  wire [6:3] cpu_ctl;
  wire [5:0] dbg_addr, dbg_addr_in;
  wire [3:2] cpu_stat, cpu_stat_set, cpu_stat_clr;
  wire [3:1] mem_ctl;
  wire [1:0] inc_step, mem_state, mem_state_nxt, dbg_mem_wr_msk, rtlc7n16, 
             rtlc7n18, rtlc7n25, rtlc38n13;
  wire dbg_wr, mem_burst, dbg_reg_rd, dbg_mem_rd, dbg_mem_rd_dly, dbg_swbrk, 
       dbg_rd, dbg_rd_rdy, mem_burst_rd, mem_burst_wr, brk0_halt, brk0_pnd, 
       brk1_halt, brk1_pnd, brk2_halt, brk2_pnd, brk3_halt, brk3_pnd, 
       reg_write, reg_read, cpu_ctl_wr, halt_cpu, run_cpu, istep, cpu_stat_wr, 
       mem_ctl_wr, mem_start, mem_bw, mem_access, mem_data_wr, mem_addr_wr, 
       dbg_mem_acc, dbg_reg_acc, mem_cnt_wr, halt_rst, halt_flag, mem_halt_cpu, 
       mem_run_cpu, halt_flag_clr, halt_flag_set, mem_burst_start, 
