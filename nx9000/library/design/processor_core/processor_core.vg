  wire tmp15, tmp14, tmp13, tmp12, tmp11, tmp10, tmp9, tmp8, tmp7, tmp6, tmp5, 
       tmp4, tmp3, tmp2, tmp1, tmp0;

  RTLC_XNOR2 inst15(
      .Z(tmp15), .A(in1_15), .B(in2_15)
