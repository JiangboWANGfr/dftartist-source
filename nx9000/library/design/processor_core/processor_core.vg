module M_RTLSIM_EQ_16(Z, in1_15, in1_14, in1_13, in1_12, in1_11, in1_10, in1_9, 
                      in1_8, in1_7, in1_6, in1_5, in1_4, in1_3, in1_2, in1_1, in1_0, 
                      in2_15, in2_14, in2_13, in2_12, in2_11, in2_10, in2_9, in2_8, 
                      in2_7, in2_6, in2_5, in2_4, in2_3, in2_2, in2_1, in2_0);
  input  in1_15, in1_14, in1_13, in1_12, in1_11, in1_10, in1_9, in1_8, in1_7, 
         in1_6, in1_5, in1_4, in1_3, in1_2, in1_1, in1_0, in2_15, in2_14, 
         in2_13, in2_12, in2_11, in2_10, in2_9, in2_8, in2_7, in2_6, in2_5, 
         in2_4, in2_3, in2_2, in2_1, in2_0;
