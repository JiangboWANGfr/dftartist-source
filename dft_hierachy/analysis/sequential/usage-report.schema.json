{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:dft-studio:analysis:sequential:3",
  "title": "Opt-in RTL control sources and sequential clock usage v3",
  "oneOf": [
    {
      "$ref": "#/$defs/Report"
    },
    {
      "$ref": "urn:dft-studio:analysis:sequential:2#/$defs/Error"
    }
  ],
  "$defs": {
    "Report": {
      "type": "object",
      "properties": {
        "formatVersion": {
          "const": 3
        },
        "algorithm": {
          "const": "rtl-control-usage-v1"
        },
        "snapshot": {
          "$ref": "urn:dft-studio:analysis:sequential:2#/$defs/Report/properties/snapshot"
        },
        "scope": {
          "$ref": "urn:dft-studio:analysis:sequential:2#/$defs/Report/properties/scope"
        },
        "recursive": {
          "$ref": "urn:dft-studio:analysis:sequential:2#/$defs/Report/properties/recursive"
        },
        "limits": {
          "type": "object",
          "properties": {
            "maxFacts": {
              "$ref": "urn:dft-studio:analysis:sequential:2#/$defs/Report/properties/limits/properties/maxFacts"
            },
            "maxInstances": {
              "$ref": "urn:dft-studio:analysis:sequential:2#/$defs/Report/properties/limits/properties/maxInstances"
            },
            "maxChecks": {
              "$ref": "urn:dft-studio:analysis:sequential:2#/$defs/Report/properties/limits/properties/maxChecks"
            },
            "maxTraceNodes": {
              "$ref": "urn:dft-studio:analysis:sequential:2#/$defs/Report/properties/limits/properties/maxTraceNodes"
            },
            "maxTraceEdges": {
              "$ref": "urn:dft-studio:analysis:sequential:2#/$defs/Report/properties/limits/properties/maxTraceEdges"
            },
            "maxDepth": {
              "$ref": "urn:dft-studio:analysis:sequential:2#/$defs/Report/properties/limits/properties/maxDepth"
            },
            "maxMillis": {
              "$ref": "urn:dft-studio:analysis:sequential:2#/$defs/Report/properties/limits/properties/maxMillis"
            },
            "maxLogicWork": {
              "$ref": "urn:dft-studio:analysis:sequential:2#/$defs/Report/properties/limits/properties/maxLogicWork"
            },
            "maxUsageWork": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000000
            }
          },
          "required": [
            "maxFacts",
            "maxInstances",
            "maxChecks",
            "maxTraceNodes",
            "maxTraceEdges",
            "maxDepth",
            "maxMillis",
            "maxLogicWork",
            "maxUsageWork"
          ],
          "additionalProperties": false
        },
        "quality": {
          "$ref": "urn:dft-studio:analysis:sequential:2#/$defs/Report/properties/quality"
        },
        "visitedInstances": {
          "$ref": "urn:dft-studio:analysis:sequential:2#/$defs/Report/properties/visitedInstances"
        },
        "registers": {
          "$ref": "urn:dft-studio:analysis:sequential:2#/$defs/Report/properties/registers"
        },
        "checks": {
          "$ref": "urn:dft-studio:analysis:sequential:2#/$defs/Report/properties/checks"
        },
        "findings": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "rule": {
                "enum": [
                  "CLK-UNCTRL",
                  "RST-UNCTRL",
                  "CLK-GEN",
                  "RST-GEN",
                  "CLK-AS-DATA"
                ]
              },
              "check": {
                "type": "integer",
                "minimum": 0
              },
              "severity": {
                "enum": [
                  "error",
                  "warning"
                ]
              }
            },
            "required": [
              "rule",
              "check",
              "severity"
            ],
            "additionalProperties": false,
            "allOf": [
              {
                "if": {
                  "properties": {
                    "rule": {
                      "const": "CLK-AS-DATA"
                    }
                  }
                },
                "then": {
                  "properties": {
                    "severity": {
                      "const": "warning"
                    }
                  }
                },
                "else": {
                  "properties": {
                    "severity": {
                      "const": "error"
                    }
                  }
                }
              }
            ]
          }
        },
        "clockUsage": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "check": {
                "type": "integer",
                "minimum": 0
              },
              "complete": {
                "type": "boolean"
              },
              "work": {
                "type": "integer",
                "minimum": 0,
                "maximum": 1000000
              },
              "reasons": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "steps": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "point": {
                      "$ref": "urn:dft-studio:hier:protocol:2:schema:7#/$defs/TracePoint"
                    },
                    "direction": {
                      "enum": [
                        "back",
                        "forward"
                      ]
                    },
                    "response": {
                      "$ref": "urn:dft-studio:analysis:sequential:2#/$defs/Report/properties/checks/items/properties/logic/properties/steps/items/properties/response"
                    }
                  },
                  "required": [
                    "point",
                    "direction",
                    "response"
                  ],
                  "additionalProperties": false
                }
              },
              "witnesses": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "step": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "hop": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "continuation": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "role": {
                      "enum": [
                        "data",
                        "control",
                        "async"
                      ]
                    }
                  },
                  "required": [
                    "step",
                    "hop",
                    "continuation",
                    "role"
                  ],
                  "additionalProperties": false
                }
              }
            },
            "required": [
              "check",
              "complete",
              "work",
              "reasons",
              "steps",
              "witnesses"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "formatVersion",
        "algorithm",
        "snapshot",
        "scope",
        "recursive",
        "limits",
        "quality",
        "visitedInstances",
        "registers",
        "checks",
        "findings",
        "clockUsage"
      ],
      "additionalProperties": false
    }
  }
}
