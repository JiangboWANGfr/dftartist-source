{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:dft-studio:analysis:register-source-deltas:1",
  "oneOf": [
    {
      "$ref": "#/$defs/Report"
    },
    {
      "$ref": "urn:dft-studio:analysis:sequential:2#/$defs/Error"
    }
  ],
  "$defs": {
    "Counts": {
      "type": "object",
      "properties": {
        "baselineBits": {
          "type": "integer",
          "minimum": 0
        },
        "scenarioBits": {
          "type": "integer",
          "minimum": 0
        },
        "addedBits": {
          "type": "integer",
          "minimum": 0
        },
        "removedBits": {
          "type": "integer",
          "minimum": 0
        },
        "retainedBits": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "baselineBits",
        "scenarioBits",
        "addedBits",
        "removedBits",
        "retainedBits"
      ],
      "additionalProperties": false
    },
    "Report": {
      "type": "object",
      "properties": {
        "formatVersion": {
          "const": 1
        },
        "algorithm": {
          "const": "rtl-register-source-deltas-v1"
        },
        "limits": {
          "type": "object",
          "properties": {
            "scenarios": {
              "$ref": "urn:dft-studio:analysis:register-source-scenarios:1#/$defs/Report/properties/limits"
            },
            "maxRows": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100000
            },
            "maxSignals": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000000
            },
            "maxRanges": {
              "type": "integer",
              "minimum": 1,
              "maximum": 2000000
            },
            "maxIntervals": {
              "type": "integer",
              "minimum": 1,
              "maximum": 2000000
            },
            "maxWork": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10000000
            },
            "maxMillis": {
              "type": "integer",
              "minimum": 1,
              "maximum": 60000
            }
          },
          "required": [
            "scenarios",
            "maxRows",
            "maxSignals",
            "maxRanges",
            "maxIntervals",
            "maxWork",
            "maxMillis"
          ],
          "additionalProperties": false
        },
        "quality": {
          "$ref": "urn:dft-studio:analysis:register-control-sources:1#/$defs/Report/properties/quality"
        },
        "analysis": {
          "$ref": "urn:dft-studio:analysis:register-source-scenarios:1#/$defs/Report"
        },
        "inputRows": {
          "type": "integer",
          "minimum": 0
        },
        "inputComparisons": {
          "type": "integer",
          "minimum": 0
        },
        "work": {
          "type": "integer",
          "minimum": 0
        },
        "signals": {
          "type": "integer",
          "minimum": 0
        },
        "ranges": {
          "type": "integer",
          "minimum": 0
        },
        "intervals": {
          "type": "integer",
          "minimum": 0
        },
        "rows": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "matrixRow": {
                "type": "integer",
                "minimum": 0
              },
              "scenario": {
                "type": "integer",
                "minimum": 1,
                "maximum": 7
              },
              "status": {
                "enum": [
                  "changed",
                  "unchanged",
                  "unresolved"
                ]
              },
              "delta": {
                "type": "object",
                "properties": {
                  "signals": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "signal": {
                          "type": "integer",
                          "minimum": 0
                        },
                        "added": {
                          "type": "array",
                          "items": {
                            "$ref": "urn:dft-studio:hier:protocol:2:schema:7#/$defs/BitRange"
                          }
                        },
                        "removed": {
                          "type": "array",
                          "items": {
                            "$ref": "urn:dft-studio:hier:protocol:2:schema:7#/$defs/BitRange"
                          }
                        },
                        "retained": {
                          "type": "array",
                          "items": {
                            "$ref": "urn:dft-studio:hier:protocol:2:schema:7#/$defs/BitRange"
                          }
                        },
                        "counts": {
                          "$ref": "#/$defs/Counts"
                        }
                      },
                      "required": [
                        "signal",
                        "added",
                        "removed",
                        "retained",
                        "counts"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "totals": {
                    "$ref": "#/$defs/Counts"
                  }
                },
                "required": [
                  "signals",
                  "totals"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "matrixRow",
              "scenario",
              "status"
            ],
            "additionalProperties": false,
            "allOf": [
              {
                "if": {
                  "properties": {
                    "status": {
                      "const": "unresolved"
                    }
                  }
                },
                "then": {
                  "not": {
                    "required": [
                      "delta"
                    ]
                  }
                },
                "else": {
                  "required": [
                    "delta"
                  ]
                }
              }
            ]
          }
        },
        "summary": {
          "type": "object",
          "properties": {
            "rows": {
              "type": "integer",
              "minimum": 0
            },
            "changed": {
              "type": "integer",
              "minimum": 0
            },
            "unchanged": {
              "type": "integer",
              "minimum": 0
            },
            "unresolved": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "rows",
            "changed",
            "unchanged",
            "unresolved"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "formatVersion",
        "algorithm",
        "limits",
        "quality",
        "analysis",
        "inputRows",
        "inputComparisons",
        "work",
        "signals",
        "ranges",
        "intervals",
        "rows",
        "summary"
      ],
      "additionalProperties": false
    }
  }
}
