{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:dft-studio:analysis:source-evidence-locations:1",
  "oneOf": [
    {
      "$ref": "#/$defs/Report"
    },
    {
      "$ref": "urn:dft-studio:analysis:sequential:2#/$defs/Error"
    }
  ],
  "$defs": {
    "Report": {
      "type": "object",
      "properties": {
        "formatVersion": {
          "const": 1
        },
        "algorithm": {
          "const": "rtl-source-evidence-locations-v1"
        },
        "analysis": {
          "$ref": "urn:dft-studio:analysis:source-range-evidence:1#/$defs/Report"
        },
        "snapshotId": {
          "type": "string",
          "minLength": 1
        },
        "scope": {
          "type": "string",
          "minLength": 1
        },
        "query": {
          "$ref": "urn:dft-studio:analysis:register-source-range-selection:1#/$defs/Report/properties/query"
        },
        "limits": {
          "type": "object",
          "properties": {
            "maxFacts": {
              "type": "integer",
              "minimum": 1,
              "maximum": 200000
            },
            "maxLocations": {
              "type": "integer",
              "minimum": 1,
              "maximum": 400000
            },
            "maxQueries": {
              "type": "integer",
              "minimum": 1,
              "maximum": 400001
            },
            "maxWork": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10000000
            },
            "maxMillis": {
              "type": "integer",
              "minimum": 1,
              "maximum": 60000
            }
          },
          "required": [
            "maxFacts",
            "maxLocations",
            "maxQueries",
            "maxWork",
            "maxMillis"
          ],
          "additionalProperties": false
        },
        "quality": {
          "$ref": "urn:dft-studio:analysis:register-control-sources:1#/$defs/Report/properties/quality"
        },
        "inputComplete": {
          "type": "boolean"
        },
        "sourcesComplete": {
          "type": "boolean"
        },
        "inputFacts": {
          "type": "integer",
          "minimum": 0
        },
        "work": {
          "type": "integer",
          "minimum": 0
        },
        "queries": {
          "type": "integer",
          "minimum": 1
        },
        "missing": {
          "type": "integer",
          "minimum": 0
        },
        "locations": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "ref": {
                "type": "string",
                "minLength": 1
              },
              "kind": {
                "enum": [
                  "definition",
                  "statement"
                ]
              },
              "status": {
                "enum": [
                  "located",
                  "not_found"
                ]
              },
              "span": {
                "$ref": "urn:dft-studio:hier:protocol:2:schema:7#/$defs/SourceSpan"
              }
            },
            "required": [
              "ref",
              "kind",
              "status"
            ],
            "additionalProperties": false,
            "allOf": [
              {
                "if": {
                  "properties": {
                    "status": {
                      "const": "located"
                    }
                  }
                },
                "then": {
                  "required": [
                    "span"
                  ]
                },
                "else": {
                  "not": {
                    "required": [
                      "span"
                    ]
                  }
                }
              }
            ]
          }
        },
        "rows": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "fact": {
                "type": "integer",
                "minimum": 0
              },
              "statisticsFact": {
                "type": "integer",
                "minimum": 0
              },
              "ref": {
                "type": "string",
                "minLength": 1
              },
              "inst": {
                "type": "string",
                "minLength": 1
              },
              "signalLocation": {
                "type": "integer",
                "minimum": 0
              },
              "processLocation": {
                "type": "integer",
                "minimum": 0
              }
            },
            "required": [
              "fact",
              "statisticsFact",
              "ref",
              "inst",
              "signalLocation",
              "processLocation"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "formatVersion",
        "algorithm",
        "analysis",
        "snapshotId",
        "scope",
        "query",
        "limits",
        "quality",
        "inputComplete",
        "sourcesComplete",
        "inputFacts",
        "work",
        "queries",
        "missing",
        "locations",
        "rows"
      ],
      "additionalProperties": false
    }
  }
}
