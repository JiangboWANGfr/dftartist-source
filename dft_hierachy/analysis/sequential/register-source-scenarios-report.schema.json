{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:dft-studio:analysis:register-source-scenarios:1",
  "oneOf": [
    {
      "$ref": "#/$defs/Report"
    },
    {
      "$ref": "urn:dft-studio:analysis:sequential:2#/$defs/Error"
    }
  ],
  "$defs": {
    "SourceView": {
      "type": "object",
      "properties": {
        "formatVersion": {
          "$ref": "urn:dft-studio:analysis:register-control-sources:1#/$defs/Report/properties/formatVersion"
        },
        "algorithm": {
          "$ref": "urn:dft-studio:analysis:register-control-sources:1#/$defs/Report/properties/algorithm"
        },
        "snapshotId": {
          "$ref": "urn:dft-studio:analysis:register-control-sources:1#/$defs/Report/properties/snapshotId"
        },
        "scope": {
          "$ref": "urn:dft-studio:analysis:register-control-sources:1#/$defs/Report/properties/scope"
        },
        "limits": {
          "$ref": "urn:dft-studio:analysis:register-control-sources:1#/$defs/Report/properties/limits"
        },
        "quality": {
          "$ref": "urn:dft-studio:analysis:register-control-sources:1#/$defs/Report/properties/quality"
        },
        "inputNodes": {
          "$ref": "urn:dft-studio:analysis:register-control-sources:1#/$defs/Report/properties/inputNodes"
        },
        "work": {
          "$ref": "urn:dft-studio:analysis:register-control-sources:1#/$defs/Report/properties/work"
        },
        "memberFacts": {
          "$ref": "urn:dft-studio:analysis:register-control-sources:1#/$defs/Report/properties/memberFacts"
        },
        "segmentCount": {
          "$ref": "urn:dft-studio:analysis:register-control-sources:1#/$defs/Report/properties/segmentCount"
        },
        "overlapMembers": {
          "$ref": "urn:dft-studio:analysis:register-control-sources:1#/$defs/Report/properties/overlapMembers"
        },
        "attributionSignals": {
          "$ref": "urn:dft-studio:analysis:register-control-sources:1#/$defs/Report/properties/attributionSignals"
        },
        "checkedSignals": {
          "$ref": "urn:dft-studio:analysis:register-control-sources:1#/$defs/Report/properties/checkedSignals"
        },
        "crossGroupBits": {
          "$ref": "urn:dft-studio:analysis:register-control-sources:1#/$defs/Report/properties/crossGroupBits"
        },
        "attributionsComplete": {
          "$ref": "urn:dft-studio:analysis:register-control-sources:1#/$defs/Report/properties/attributionsComplete"
        },
        "rows": {
          "$ref": "urn:dft-studio:analysis:register-control-sources:1#/$defs/Report/properties/rows"
        },
        "groups": {
          "$ref": "urn:dft-studio:analysis:register-control-sources:1#/$defs/Report/properties/groups"
        },
        "attributions": {
          "$ref": "urn:dft-studio:analysis:register-control-sources:1#/$defs/Report/properties/attributions"
        },
        "summary": {
          "$ref": "urn:dft-studio:analysis:register-control-sources:1#/$defs/Report/properties/summary"
        }
      },
      "required": [
        "formatVersion",
        "algorithm",
        "snapshotId",
        "scope",
        "limits",
        "quality",
        "inputNodes",
        "work",
        "memberFacts",
        "segmentCount",
        "overlapMembers",
        "attributionSignals",
        "checkedSignals",
        "crossGroupBits",
        "attributionsComplete",
        "rows",
        "groups",
        "attributions",
        "summary"
      ],
      "additionalProperties": false
    },
    "FanoutView": {
      "type": "object",
      "properties": {
        "formatVersion": {
          "$ref": "urn:dft-studio:analysis:register-control-fanout:1#/$defs/Report/properties/formatVersion"
        },
        "algorithm": {
          "$ref": "urn:dft-studio:analysis:register-control-fanout:1#/$defs/Report/properties/algorithm"
        },
        "snapshotId": {
          "$ref": "urn:dft-studio:analysis:register-control-fanout:1#/$defs/Report/properties/snapshotId"
        },
        "scope": {
          "$ref": "urn:dft-studio:analysis:register-control-fanout:1#/$defs/Report/properties/scope"
        },
        "limits": {
          "$ref": "urn:dft-studio:analysis:register-control-fanout:1#/$defs/Report/properties/limits"
        },
        "quality": {
          "$ref": "urn:dft-studio:analysis:register-control-fanout:1#/$defs/Report/properties/quality"
        },
        "inputOrigins": {
          "$ref": "urn:dft-studio:analysis:register-control-fanout:1#/$defs/Report/properties/inputOrigins"
        },
        "inputSeeds": {
          "$ref": "urn:dft-studio:analysis:register-control-fanout:1#/$defs/Report/properties/inputSeeds"
        },
        "inputNodes": {
          "$ref": "urn:dft-studio:analysis:register-control-fanout:1#/$defs/Report/properties/inputNodes"
        },
        "relevantSeeds": {
          "$ref": "urn:dft-studio:analysis:register-control-fanout:1#/$defs/Report/properties/relevantSeeds"
        },
        "work": {
          "$ref": "urn:dft-studio:analysis:register-control-fanout:1#/$defs/Report/properties/work"
        },
        "links": {
          "$ref": "urn:dft-studio:analysis:register-control-fanout:1#/$defs/Report/properties/links"
        },
        "memberFacts": {
          "$ref": "urn:dft-studio:analysis:register-control-fanout:1#/$defs/Report/properties/memberFacts"
        },
        "segmentCount": {
          "$ref": "urn:dft-studio:analysis:register-control-fanout:1#/$defs/Report/properties/segmentCount"
        },
        "origins": {
          "$ref": "urn:dft-studio:analysis:register-control-fanout:1#/$defs/Report/properties/origins"
        },
        "seeds": {
          "$ref": "urn:dft-studio:analysis:register-control-fanout:1#/$defs/Report/properties/seeds"
        },
        "nodes": {
          "$ref": "urn:dft-studio:analysis:register-control-fanout:1#/$defs/Report/properties/nodes"
        },
        "summary": {
          "$ref": "urn:dft-studio:analysis:register-control-fanout:1#/$defs/Report/properties/summary"
        }
      },
      "required": [
        "formatVersion",
        "algorithm",
        "snapshotId",
        "scope",
        "limits",
        "quality",
        "inputOrigins",
        "inputSeeds",
        "inputNodes",
        "relevantSeeds",
        "work",
        "links",
        "memberFacts",
        "segmentCount",
        "origins",
        "seeds",
        "nodes",
        "summary"
      ],
      "additionalProperties": false
    },
    "Report": {
      "type": "object",
      "properties": {
        "formatVersion": {
          "const": 1
        },
        "algorithm": {
          "const": "rtl-register-source-scenarios-v1"
        },
        "limits": {
          "type": "object",
          "properties": {
            "generation": {
              "$ref": "urn:dft-studio:analysis:register-generation-scenarios:1#/$defs/Report/properties/limits"
            },
            "sources": {
              "$ref": "urn:dft-studio:analysis:register-control-sources:1#/$defs/Report/properties/limits"
            },
            "fanout": {
              "$ref": "urn:dft-studio:analysis:register-control-fanout:1#/$defs/Report/properties/limits"
            },
            "maxRows": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100000
            },
            "maxCells": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000000
            },
            "maxIntervals": {
              "type": "integer",
              "minimum": 1,
              "maximum": 2000000
            },
            "maxWork": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10000000
            },
            "maxMillis": {
              "type": "integer",
              "minimum": 1,
              "maximum": 60000
            }
          },
          "required": [
            "generation",
            "sources",
            "fanout",
            "maxRows",
            "maxCells",
            "maxIntervals",
            "maxWork",
            "maxMillis"
          ],
          "additionalProperties": false
        },
        "quality": {
          "$ref": "urn:dft-studio:analysis:register-control-sources:1#/$defs/Report/properties/quality"
        },
        "analysis": {
          "$ref": "urn:dft-studio:analysis:register-generation-scenarios:1#/$defs/Report"
        },
        "scenarios": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "scenario": {
                "type": "integer",
                "minimum": 0
              },
              "name": {
                "type": "string"
              },
              "status": {
                "enum": [
                  "not_run",
                  "complete",
                  "partial"
                ]
              },
              "reasons": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "sources": {
                "$ref": "#/$defs/SourceView"
              },
              "fanout": {
                "$ref": "#/$defs/FanoutView"
              }
            },
            "required": [
              "scenario",
              "name",
              "status",
              "reasons"
            ],
            "additionalProperties": false,
            "allOf": [
              {
                "if": {
                  "properties": {
                    "status": {
                      "const": "not_run"
                    }
                  }
                },
                "then": {
                  "not": {
                    "anyOf": [
                      {
                        "required": [
                          "sources"
                        ]
                      },
                      {
                        "required": [
                          "fanout"
                        ]
                      }
                    ]
                  }
                },
                "else": {
                  "required": [
                    "sources",
                    "fanout"
                  ]
                }
              }
            ]
          },
          "minItems": 2,
          "maxItems": 8
        },
        "indexComplete": {
          "type": "boolean"
        },
        "inputSources": {
          "type": "integer",
          "minimum": 0
        },
        "indexedGroups": {
          "type": "integer",
          "minimum": 0
        },
        "work": {
          "type": "integer",
          "minimum": 0
        },
        "cells": {
          "type": "integer",
          "minimum": 0
        },
        "intervals": {
          "type": "integer",
          "minimum": 0
        },
        "rows": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "source": {
                "$ref": "urn:dft-studio:analysis:register-control-sources:1#/$defs/Report/properties/groups/items/properties/source"
              },
              "groups": {
                "type": "array",
                "items": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "minimum": 0
                },
                "minItems": 2,
                "maxItems": 8
              },
              "status": {
                "type": "array",
                "items": {
                  "enum": [
                    "changed",
                    "unchanged",
                    "unresolved"
                  ]
                },
                "minItems": 1,
                "maxItems": 7
              }
            },
            "required": [
              "source",
              "groups",
              "status"
            ],
            "additionalProperties": false
          }
        },
        "summary": {
          "type": "object",
          "properties": {
            "scenarios": {
              "type": "integer",
              "minimum": 0
            },
            "notRun": {
              "type": "integer",
              "minimum": 0
            },
            "rows": {
              "type": "integer",
              "minimum": 0
            },
            "comparisons": {
              "type": "integer",
              "minimum": 0
            },
            "changed": {
              "type": "integer",
              "minimum": 0
            },
            "unchanged": {
              "type": "integer",
              "minimum": 0
            },
            "unresolved": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "scenarios",
            "notRun",
            "rows",
            "comparisons",
            "changed",
            "unchanged",
            "unresolved"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "formatVersion",
        "algorithm",
        "limits",
        "quality",
        "analysis",
        "scenarios",
        "indexComplete",
        "inputSources",
        "indexedGroups",
        "work",
        "cells",
        "intervals",
        "rows",
        "summary"
      ],
      "additionalProperties": false
    }
  }
}
