{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:dft-studio:analysis:register-source-hierarchy:1",
  "oneOf": [
    {
      "$ref": "#/$defs/Report"
    },
    {
      "$ref": "urn:dft-studio:analysis:sequential:2#/$defs/Error"
    }
  ],
  "$defs": {
    "Report": {
      "type": "object",
      "properties": {
        "formatVersion": {
          "const": 1
        },
        "algorithm": {
          "const": "rtl-register-source-hierarchy-v1"
        },
        "limits": {
          "type": "object",
          "properties": {
            "maxQueries": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100000
            },
            "maxAncestors": {
              "type": "integer",
              "minimum": 1,
              "maximum": 2000000
            },
            "maxNodes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100000
            },
            "maxMembers": {
              "type": "integer",
              "minimum": 1,
              "maximum": 2000000
            },
            "maxWork": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10000000
            },
            "maxMillis": {
              "type": "integer",
              "minimum": 1,
              "maximum": 60000
            }
          },
          "required": [
            "maxQueries",
            "maxAncestors",
            "maxNodes",
            "maxMembers",
            "maxWork",
            "maxMillis"
          ],
          "additionalProperties": false
        },
        "quality": {
          "$ref": "urn:dft-studio:analysis:register-control-sources:1#/$defs/Report/properties/quality"
        },
        "analysis": {
          "$ref": "urn:dft-studio:analysis:register-source-impact:1#/$defs/Report"
        },
        "queries": {
          "type": "integer",
          "minimum": 0
        },
        "ancestorEntries": {
          "type": "integer",
          "minimum": 0
        },
        "work": {
          "type": "integer",
          "minimum": 0
        },
        "nodeRows": {
          "type": "integer",
          "minimum": 0
        },
        "members": {
          "type": "integer",
          "minimum": 0
        },
        "comparisons": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Comparison"
          },
          "minItems": 1,
          "maxItems": 7
        },
        "scope": {
          "$ref": "urn:dft-studio:hier:protocol:2:schema:7#/$defs/InstInfo"
        }
      },
      "required": [
        "formatVersion",
        "algorithm",
        "limits",
        "quality",
        "analysis",
        "queries",
        "ancestorEntries",
        "work",
        "nodeRows",
        "members",
        "comparisons"
      ],
      "additionalProperties": false
    },
    "Node": {
      "type": "object",
      "properties": {
        "info": {
          "$ref": "urn:dft-studio:hier:protocol:2:schema:7#/$defs/InstInfo"
        },
        "parent": {
          "type": [
            "string",
            "null"
          ]
        },
        "depth": {
          "type": "integer",
          "minimum": 0
        },
        "local": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "members": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "counts": {
          "$ref": "urn:dft-studio:analysis:register-source-attribution:1#/$defs/Counts"
        }
      },
      "required": [
        "info",
        "parent",
        "depth",
        "local",
        "members",
        "counts"
      ],
      "additionalProperties": false
    },
    "Comparison": {
      "type": "object",
      "properties": {
        "scenario": {
          "type": "integer",
          "minimum": 1,
          "maximum": 7
        },
        "state": {
          "enum": [
            "complete",
            "partial",
            "not_run"
          ]
        },
        "inputCollected": {
          "type": "boolean"
        },
        "inputComplete": {
          "type": "boolean"
        },
        "sourcesComplete": {
          "type": "boolean"
        },
        "inputRows": {
          "type": "integer",
          "minimum": 0
        },
        "nodes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Node"
          }
        },
        "totals": {
          "$ref": "urn:dft-studio:analysis:register-source-attribution:1#/$defs/Counts"
        }
      },
      "required": [
        "scenario",
        "state",
        "inputCollected",
        "inputComplete",
        "sourcesComplete",
        "inputRows",
        "nodes",
        "totals"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "const": "complete"
              }
            }
          },
          "then": {
            "properties": {
              "inputCollected": {
                "const": true
              },
              "inputComplete": {
                "const": true
              },
              "sourcesComplete": {
                "const": true
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "inputCollected": {
                "const": false
              }
            }
          },
          "then": {
            "properties": {
              "nodes": {
                "maxItems": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "const": "not_run"
              }
            }
          },
          "then": {
            "properties": {
              "inputCollected": {
                "const": false
              }
            }
          }
        }
      ]
    }
  }
}
