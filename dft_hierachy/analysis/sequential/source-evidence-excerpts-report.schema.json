{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:dft-studio:analysis:source-evidence-excerpts:1",
  "oneOf": [
    {
      "$ref": "#/$defs/Report"
    },
    {
      "$ref": "urn:dft-studio:analysis:sequential:2#/$defs/Error"
    }
  ],
  "$defs": {
    "Report": {
      "type": "object",
      "properties": {
        "formatVersion": {
          "const": 1
        },
        "algorithm": {
          "const": "rtl-source-evidence-excerpts-v1"
        },
        "analysis": {
          "$ref": "urn:dft-studio:analysis:source-evidence-locations:1#/$defs/Report"
        },
        "snapshotId": {
          "type": "string",
          "minLength": 1
        },
        "scope": {
          "type": "string",
          "minLength": 1
        },
        "query": {
          "$ref": "urn:dft-studio:analysis:register-source-range-selection:1#/$defs/Report/properties/query"
        },
        "limits": {
          "type": "object",
          "properties": {
            "contextLines": {
              "type": "integer",
              "minimum": 0,
              "maximum": 20
            },
            "maxLocations": {
              "type": "integer",
              "minimum": 1,
              "maximum": 400000
            },
            "maxFiles": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10000
            },
            "maxQueries": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10001
            },
            "maxBytes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 16777216
            },
            "maxSnippetBytes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1048576
            },
            "maxCachedBytes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 67108864
            },
            "maxWork": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10000000
            },
            "maxMillis": {
              "type": "integer",
              "minimum": 1,
              "maximum": 60000
            }
          },
          "required": [
            "contextLines",
            "maxLocations",
            "maxFiles",
            "maxQueries",
            "maxBytes",
            "maxSnippetBytes",
            "maxCachedBytes",
            "maxWork",
            "maxMillis"
          ],
          "additionalProperties": false
        },
        "quality": {
          "$ref": "urn:dft-studio:analysis:register-control-sources:1#/$defs/Report/properties/quality"
        },
        "inputComplete": {
          "type": "boolean"
        },
        "sourcesComplete": {
          "type": "boolean"
        },
        "inputLocations": {
          "type": "integer",
          "minimum": 0
        },
        "work": {
          "type": "integer",
          "minimum": 0
        },
        "queries": {
          "type": "integer",
          "minimum": 1
        },
        "readBytes": {
          "type": "integer",
          "minimum": 0
        },
        "cachedBytes": {
          "type": "integer",
          "minimum": 0
        },
        "bytes": {
          "type": "integer",
          "minimum": 0
        },
        "files": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "file": {
                "type": "string",
                "minLength": 1
              },
              "path": {
                "type": "string",
                "minLength": 1
              },
              "snapshotHash": {
                "type": "string",
                "minLength": 1
              },
              "state": {
                "enum": [
                  "read",
                  "not_found",
                  "unsupported"
                ]
              },
              "contentHash": {
                "type": "string",
                "minLength": 1
              },
              "matchesSnapshot": {
                "type": "boolean"
              }
            },
            "required": [
              "file",
              "path",
              "snapshotHash",
              "state"
            ],
            "additionalProperties": false,
            "allOf": [
              {
                "if": {
                  "properties": {
                    "state": {
                      "const": "read"
                    }
                  }
                },
                "then": {
                  "required": [
                    "contentHash",
                    "matchesSnapshot"
                  ]
                },
                "else": {
                  "not": {
                    "anyOf": [
                      {
                        "required": [
                          "contentHash"
                        ]
                      },
                      {
                        "required": [
                          "matchesSnapshot"
                        ]
                      }
                    ]
                  }
                }
              }
            ]
          }
        },
        "snippets": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "file": {
                "type": "integer",
                "minimum": 0
              },
              "startOffset": {
                "type": "integer",
                "minimum": 0
              },
              "endOffset": {
                "type": "integer",
                "minimum": 0
              },
              "startLine": {
                "type": "integer",
                "minimum": 1
              },
              "text": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "file",
              "startOffset",
              "endOffset",
              "startLine",
              "text"
            ],
            "additionalProperties": false
          }
        },
        "rows": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "location": {
                "type": "integer",
                "minimum": 0
              },
              "state": {
                "enum": [
                  "available",
                  "location_unavailable",
                  "file_not_found",
                  "unsupported",
                  "changed"
                ]
              },
              "file": {
                "type": "integer",
                "minimum": 0
              },
              "snippet": {
                "type": "integer",
                "minimum": 0
              }
            },
            "required": [
              "location",
              "state"
            ],
            "additionalProperties": false,
            "allOf": [
              {
                "if": {
                  "properties": {
                    "state": {
                      "const": "available"
                    }
                  }
                },
                "then": {
                  "required": [
                    "file",
                    "snippet"
                  ]
                },
                "else": {
                  "not": {
                    "required": [
                      "snippet"
                    ]
                  }
                }
              },
              {
                "if": {
                  "properties": {
                    "state": {
                      "const": "location_unavailable"
                    }
                  }
                },
                "then": {
                  "not": {
                    "required": [
                      "file"
                    ]
                  }
                },
                "else": {
                  "required": [
                    "file"
                  ]
                }
              }
            ]
          }
        }
      },
      "required": [
        "formatVersion",
        "algorithm",
        "analysis",
        "snapshotId",
        "scope",
        "query",
        "limits",
        "quality",
        "inputComplete",
        "sourcesComplete",
        "inputLocations",
        "work",
        "queries",
        "readBytes",
        "cachedBytes",
        "bytes",
        "files",
        "snippets",
        "rows"
      ],
      "additionalProperties": false
    }
  }
}
