{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:dft-studio:analysis:register-scenarios:1",
  "oneOf": [
    {
      "$ref": "#/$defs/Report"
    },
    {
      "$ref": "urn:dft-studio:analysis:sequential:2#/$defs/Error"
    }
  ],
  "$defs": {
    "ProfileView": {
      "type": "object",
      "properties": {
        "formatVersion": {
          "$ref": "urn:dft-studio:analysis:register-control-profile:1#/$defs/Report/properties/formatVersion"
        },
        "algorithm": {
          "$ref": "urn:dft-studio:analysis:register-control-profile:1#/$defs/Report/properties/algorithm"
        },
        "snapshotId": {
          "$ref": "urn:dft-studio:analysis:register-control-profile:1#/$defs/Report/properties/snapshotId"
        },
        "scope": {
          "$ref": "urn:dft-studio:analysis:register-control-profile:1#/$defs/Report/properties/scope"
        },
        "options": {
          "$ref": "urn:dft-studio:analysis:register-control-profile:1#/$defs/Report/properties/options"
        },
        "clockRoots": {
          "$ref": "urn:dft-studio:analysis:register-control-profile:1#/$defs/Report/properties/clockRoots"
        },
        "inputValues": {
          "$ref": "urn:dft-studio:analysis:register-control-profile:1#/$defs/Report/properties/inputValues"
        },
        "quality": {
          "$ref": "urn:dft-studio:analysis:register-control-profile:1#/$defs/Report/properties/quality"
        },
        "processedGroups": {
          "$ref": "urn:dft-studio:analysis:register-control-profile:1#/$defs/Report/properties/processedGroups"
        },
        "visitedEvents": {
          "$ref": "urn:dft-studio:analysis:register-control-profile:1#/$defs/Report/properties/visitedEvents"
        },
        "attributedFacts": {
          "$ref": "urn:dft-studio:analysis:register-control-profile:1#/$defs/Report/properties/attributedFacts"
        },
        "traceNodes": {
          "$ref": "urn:dft-studio:analysis:register-control-profile:1#/$defs/Report/properties/traceNodes"
        },
        "traceEdges": {
          "$ref": "urn:dft-studio:analysis:register-control-profile:1#/$defs/Report/properties/traceEdges"
        },
        "logicWork": {
          "$ref": "urn:dft-studio:analysis:register-control-profile:1#/$defs/Report/properties/logicWork"
        },
        "work": {
          "$ref": "urn:dft-studio:analysis:register-control-profile:1#/$defs/Report/properties/work"
        },
        "segmentCount": {
          "$ref": "urn:dft-studio:analysis:register-control-profile:1#/$defs/Report/properties/segmentCount"
        },
        "checks": {
          "$ref": "urn:dft-studio:analysis:register-control-profile:1#/$defs/Report/properties/checks"
        },
        "groupControls": {
          "$ref": "urn:dft-studio:analysis:register-control-profile:1#/$defs/Report/properties/groupControls"
        },
        "cohorts": {
          "$ref": "urn:dft-studio:analysis:register-control-profile:1#/$defs/Report/properties/cohorts"
        },
        "signals": {
          "$ref": "urn:dft-studio:analysis:register-control-profile:1#/$defs/Report/properties/signals"
        },
        "summary": {
          "$ref": "urn:dft-studio:analysis:register-control-profile:1#/$defs/Report/properties/summary"
        }
      },
      "required": [
        "formatVersion",
        "algorithm",
        "snapshotId",
        "scope",
        "options",
        "clockRoots",
        "inputValues",
        "quality",
        "processedGroups",
        "visitedEvents",
        "attributedFacts",
        "traceNodes",
        "traceEdges",
        "logicWork",
        "work",
        "segmentCount",
        "checks",
        "groupControls",
        "cohorts",
        "signals",
        "summary"
      ],
      "additionalProperties": false
    },
    "ResolvedView": {
      "type": "object",
      "properties": {
        "formatVersion": {
          "$ref": "urn:dft-studio:analysis:register-resolved-events:1#/$defs/Report/properties/formatVersion"
        },
        "algorithm": {
          "$ref": "urn:dft-studio:analysis:register-resolved-events:1#/$defs/Report/properties/algorithm"
        },
        "snapshotId": {
          "$ref": "urn:dft-studio:analysis:register-resolved-events:1#/$defs/Report/properties/snapshotId"
        },
        "scope": {
          "$ref": "urn:dft-studio:analysis:register-resolved-events:1#/$defs/Report/properties/scope"
        },
        "limits": {
          "$ref": "urn:dft-studio:analysis:register-resolved-events:1#/$defs/Report/properties/limits"
        },
        "quality": {
          "$ref": "urn:dft-studio:analysis:register-resolved-events:1#/$defs/Report/properties/quality"
        },
        "inputRawGroups": {
          "$ref": "urn:dft-studio:analysis:register-resolved-events:1#/$defs/Report/properties/inputRawGroups"
        },
        "inputFacts": {
          "$ref": "urn:dft-studio:analysis:register-resolved-events:1#/$defs/Report/properties/inputFacts"
        },
        "processedRawGroups": {
          "$ref": "urn:dft-studio:analysis:register-resolved-events:1#/$defs/Report/properties/processedRawGroups"
        },
        "resolvedRows": {
          "$ref": "urn:dft-studio:analysis:register-resolved-events:1#/$defs/Report/properties/resolvedRows"
        },
        "visitedEvents": {
          "$ref": "urn:dft-studio:analysis:register-resolved-events:1#/$defs/Report/properties/visitedEvents"
        },
        "assignedFacts": {
          "$ref": "urn:dft-studio:analysis:register-resolved-events:1#/$defs/Report/properties/assignedFacts"
        },
        "work": {
          "$ref": "urn:dft-studio:analysis:register-resolved-events:1#/$defs/Report/properties/work"
        },
        "segmentCount": {
          "$ref": "urn:dft-studio:analysis:register-resolved-events:1#/$defs/Report/properties/segmentCount"
        },
        "checkedSignals": {
          "$ref": "urn:dft-studio:analysis:register-resolved-events:1#/$defs/Report/properties/checkedSignals"
        },
        "crossGroupBits": {
          "$ref": "urn:dft-studio:analysis:register-resolved-events:1#/$defs/Report/properties/crossGroupBits"
        },
        "overlapMembers": {
          "$ref": "urn:dft-studio:analysis:register-resolved-events:1#/$defs/Report/properties/overlapMembers"
        },
        "rows": {
          "$ref": "urn:dft-studio:analysis:register-resolved-events:1#/$defs/Report/properties/rows"
        },
        "groups": {
          "$ref": "urn:dft-studio:analysis:register-resolved-events:1#/$defs/Report/properties/groups"
        },
        "signals": {
          "$ref": "urn:dft-studio:analysis:register-resolved-events:1#/$defs/Report/properties/signals"
        },
        "attributions": {
          "$ref": "urn:dft-studio:analysis:register-resolved-events:1#/$defs/Report/properties/attributions"
        },
        "summary": {
          "$ref": "urn:dft-studio:analysis:register-resolved-events:1#/$defs/Report/properties/summary"
        }
      },
      "required": [
        "formatVersion",
        "algorithm",
        "snapshotId",
        "scope",
        "limits",
        "quality",
        "inputRawGroups",
        "inputFacts",
        "processedRawGroups",
        "resolvedRows",
        "visitedEvents",
        "assignedFacts",
        "work",
        "segmentCount",
        "checkedSignals",
        "crossGroupBits",
        "overlapMembers",
        "rows",
        "groups",
        "signals",
        "attributions",
        "summary"
      ],
      "additionalProperties": false
    },
    "Report": {
      "type": "object",
      "properties": {
        "formatVersion": {
          "const": 1
        },
        "algorithm": {
          "const": "rtl-register-scenarios-v1"
        },
        "snapshotId": {
          "type": "string"
        },
        "scope": {
          "type": "string"
        },
        "commonOptions": {
          "allOf": [
            {
              "$ref": "urn:dft-studio:analysis:register-control-profile:1#/$defs/Report/properties/options"
            },
            {
              "properties": {
                "resolveLogic": {
                  "const": true
                },
                "inputValuesRequested": {
                  "maxItems": 0
                }
              }
            }
          ]
        },
        "resolvedLimits": {
          "$ref": "urn:dft-studio:analysis:register-resolved-events:1#/$defs/Report/properties/limits"
        },
        "limits": {
          "type": "object",
          "properties": {
            "maxScenarios": {
              "const": 8
            },
            "maxMillis": {
              "type": "integer",
              "minimum": 1,
              "maximum": 60000
            },
            "maxComparisons": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100000
            },
            "maxWork": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10000000
            },
            "maxMembers": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000000
            },
            "maxSegments": {
              "type": "integer",
              "minimum": 1,
              "maximum": 2000000
            }
          },
          "required": [
            "maxScenarios",
            "maxMillis",
            "maxComparisons",
            "maxWork",
            "maxMembers",
            "maxSegments"
          ],
          "additionalProperties": false
        },
        "quality": {
          "type": "object",
          "properties": {
            "completeness": {
              "enum": [
                "complete",
                "partial"
              ]
            },
            "reasons": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "uniqueItems": true
            }
          },
          "required": [
            "completeness",
            "reasons"
          ],
          "additionalProperties": false
        },
        "analysis": {
          "$ref": "urn:dft-studio:analysis:register-event-groups:1#/$defs/Report"
        },
        "work": {
          "type": "integer",
          "minimum": 0
        },
        "comparisonRows": {
          "type": "integer",
          "minimum": 0
        },
        "memberFacts": {
          "type": "integer",
          "minimum": 0
        },
        "segmentCount": {
          "type": "integer",
          "minimum": 0
        },
        "scenarios": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "inputValuesRequested": {
                "$ref": "urn:dft-studio:analysis:register-control-profile:1#/$defs/Report/properties/options/properties/inputValuesRequested"
              },
              "status": {
                "enum": [
                  "not_run",
                  "profile_only",
                  "complete",
                  "partial"
                ]
              },
              "reasons": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "maxItems": 1000000,
                "uniqueItems": true
              },
              "profile": {
                "$ref": "#/$defs/ProfileView"
              },
              "resolved": {
                "$ref": "#/$defs/ResolvedView"
              }
            },
            "required": [
              "name",
              "inputValuesRequested",
              "status",
              "reasons"
            ],
            "additionalProperties": false,
            "allOf": [
              {
                "if": {
                  "properties": {
                    "status": {
                      "const": "not_run"
                    }
                  }
                },
                "then": {
                  "not": {
                    "anyOf": [
                      {
                        "required": [
                          "profile"
                        ]
                      },
                      {
                        "required": [
                          "resolved"
                        ]
                      }
                    ]
                  }
                }
              },
              {
                "if": {
                  "properties": {
                    "status": {
                      "const": "profile_only"
                    }
                  }
                },
                "then": {
                  "required": [
                    "profile"
                  ],
                  "not": {
                    "required": [
                      "resolved"
                    ]
                  }
                }
              },
              {
                "if": {
                  "properties": {
                    "status": {
                      "enum": [
                        "complete",
                        "partial"
                      ]
                    }
                  }
                },
                "then": {
                  "required": [
                    "profile",
                    "resolved"
                  ]
                }
              }
            ]
          },
          "maxItems": 8,
          "minItems": 2
        },
        "comparisons": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "baseline": {
                "const": 0
              },
              "scenario": {
                "type": "integer",
                "minimum": 1,
                "maximum": 7
              },
              "inputGroups": {
                "type": "integer",
                "minimum": 0
              },
              "processedGroups": {
                "type": "integer",
                "minimum": 0
              },
              "quality": {
                "type": "object",
                "properties": {
                  "completeness": {
                    "enum": [
                      "complete",
                      "partial"
                    ]
                  },
                  "reasons": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "uniqueItems": true
                  }
                },
                "required": [
                  "completeness",
                  "reasons"
                ],
                "additionalProperties": false
              },
              "rows": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "rawGroup": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "baselineGroup": {
                      "type": [
                        "integer",
                        "null"
                      ],
                      "minimum": 0
                    },
                    "scenarioGroup": {
                      "type": [
                        "integer",
                        "null"
                      ],
                      "minimum": 0
                    },
                    "status": {
                      "enum": [
                        "changed",
                        "unchanged",
                        "unresolved"
                      ]
                    },
                    "reasons": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      },
                      "maxItems": 1000000,
                      "uniqueItems": true
                    }
                  },
                  "required": [
                    "rawGroup",
                    "baselineGroup",
                    "scenarioGroup",
                    "status",
                    "reasons"
                  ],
                  "additionalProperties": false
                },
                "maxItems": 100000
              },
              "changedSignals": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "signal": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "facts": {
                      "type": "array",
                      "items": {
                        "type": "integer",
                        "minimum": 0
                      },
                      "maxItems": 1000000,
                      "uniqueItems": true
                    },
                    "coverage": {
                      "$ref": "urn:dft-studio:analysis:register-statistics:1#/$defs/Report/properties/signals/items/properties/coverage"
                    }
                  },
                  "required": [
                    "signal",
                    "facts"
                  ],
                  "additionalProperties": false
                },
                "maxItems": 1000000
              },
              "changedTotals": {
                "$ref": "urn:dft-studio:analysis:register-statistics:1#/$defs/Report/properties/totals"
              }
            },
            "required": [
              "baseline",
              "scenario",
              "inputGroups",
              "processedGroups",
              "quality",
              "rows",
              "changedSignals",
              "changedTotals"
            ],
            "additionalProperties": false
          },
          "maxItems": 7,
          "minItems": 1
        },
        "summary": {
          "type": "object",
          "properties": {
            "scenarios": {
              "type": "integer",
              "minimum": 0
            },
            "profiled": {
              "type": "integer",
              "minimum": 0
            },
            "resolved": {
              "type": "integer",
              "minimum": 0
            },
            "notRun": {
              "type": "integer",
              "minimum": 0
            },
            "comparisons": {
              "type": "integer",
              "minimum": 0
            },
            "rows": {
              "type": "integer",
              "minimum": 0
            },
            "changed": {
              "type": "integer",
              "minimum": 0
            },
            "unchanged": {
              "type": "integer",
              "minimum": 0
            },
            "unresolved": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "scenarios",
            "profiled",
            "resolved",
            "notRun",
            "comparisons",
            "rows",
            "changed",
            "unchanged",
            "unresolved"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "formatVersion",
        "algorithm",
        "snapshotId",
        "scope",
        "commonOptions",
        "resolvedLimits",
        "limits",
        "quality",
        "analysis",
        "work",
        "comparisonRows",
        "memberFacts",
        "segmentCount",
        "scenarios",
        "comparisons",
        "summary"
      ],
      "additionalProperties": false
    }
  }
}
