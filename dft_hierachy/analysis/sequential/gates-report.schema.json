{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:dft-studio:analysis:sequential:4",
  "title": "Explicit rooted RTL clock gates v4",
  "oneOf": [
    {
      "$ref": "#/$defs/Report"
    },
    {
      "$ref": "urn:dft-studio:analysis:sequential:2#/$defs/Error"
    }
  ],
  "$defs": {
    "LogicValue": {
      "type": "object",
      "properties": {
        "verdict": {
          "anyOf": [
            {
              "$ref": "urn:dft-studio:analysis:sequential:2#/$defs/Report/properties/checks/items/properties/logic/properties/result/properties/verdict"
            },
            {
              "const": "gated"
            }
          ]
        },
        "origin": {
          "$ref": "urn:dft-studio:analysis:sequential:2#/$defs/Report/properties/checks/items/properties/logic/properties/result/properties/origin"
        },
        "sourceRef": {
          "$ref": "urn:dft-studio:analysis:sequential:2#/$defs/Report/properties/checks/items/properties/logic/properties/result/properties/sourceRef"
        },
        "value": {
          "$ref": "urn:dft-studio:analysis:sequential:2#/$defs/Report/properties/checks/items/properties/logic/properties/result/properties/value"
        },
        "inversions": {
          "$ref": "urn:dft-studio:analysis:sequential:2#/$defs/Report/properties/checks/items/properties/logic/properties/result/properties/inversions"
        },
        "gate": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "verdict",
        "inversions"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "verdict": {
                "const": "gated"
              }
            }
          },
          "then": {
            "required": [
              "gate"
            ]
          },
          "else": {
            "not": {
              "required": [
                "gate"
              ]
            }
          }
        }
      ]
    },
    "Gate": {
      "type": "object",
      "properties": {
        "op": {
          "enum": [
            "and",
            "or"
          ]
        },
        "process": {
          "$ref": "urn:dft-studio:hier:protocol:2:schema:7#/$defs/ObjectRef"
        },
        "point": {
          "$ref": "urn:dft-studio:hier:protocol:2:schema:7#/$defs/TracePoint"
        },
        "exprPath": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          },
          "maxItems": 1000
        },
        "clock": {
          "allOf": [
            {
              "$ref": "#/$defs/LogicValue"
            },
            {
              "properties": {
                "verdict": {
                  "const": "primary_input"
                }
              },
              "required": [
                "origin",
                "sourceRef"
              ]
            }
          ]
        },
        "enable": {
          "allOf": [
            {
              "$ref": "#/$defs/LogicValue"
            },
            {
              "properties": {
                "verdict": {
                  "enum": [
                    "primary_input",
                    "generated",
                    "undriven"
                  ]
                }
              },
              "required": [
                "origin"
              ]
            }
          ]
        },
        "bit": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "op",
        "process",
        "point",
        "exprPath",
        "clock",
        "enable",
        "bit"
      ],
      "additionalProperties": false
    },
    "Report": {
      "type": "object",
      "properties": {
        "formatVersion": {
          "const": 4
        },
        "algorithm": {
          "const": "rtl-rooted-gates-v1"
        },
        "snapshot": {
          "$ref": "urn:dft-studio:analysis:sequential:2#/$defs/Report/properties/snapshot"
        },
        "scope": {
          "$ref": "urn:dft-studio:analysis:sequential:2#/$defs/Report/properties/scope"
        },
        "recursive": {
          "$ref": "urn:dft-studio:analysis:sequential:2#/$defs/Report/properties/recursive"
        },
        "limits": {
          "oneOf": [
            {
              "$ref": "urn:dft-studio:analysis:sequential:2#/$defs/Report/properties/limits"
            },
            {
              "$ref": "urn:dft-studio:analysis:sequential:3#/$defs/Report/properties/limits"
            }
          ]
        },
        "quality": {
          "$ref": "urn:dft-studio:analysis:sequential:2#/$defs/Report/properties/quality"
        },
        "visitedInstances": {
          "$ref": "urn:dft-studio:analysis:sequential:2#/$defs/Report/properties/visitedInstances"
        },
        "registers": {
          "$ref": "urn:dft-studio:analysis:sequential:2#/$defs/Report/properties/registers"
        },
        "checks": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "point": {
                "$ref": "urn:dft-studio:analysis:sequential:2#/$defs/Report/properties/checks/items/properties/point"
              },
              "path": {
                "$ref": "urn:dft-studio:analysis:sequential:2#/$defs/Report/properties/checks/items/properties/path"
              },
              "verdict": {
                "anyOf": [
                  {
                    "$ref": "urn:dft-studio:analysis:sequential:2#/$defs/Report/properties/checks/items/properties/logic/properties/result/properties/verdict"
                  },
                  {
                    "const": "gated"
                  }
                ]
              },
              "reasons": {
                "$ref": "urn:dft-studio:analysis:sequential:2#/$defs/Report/properties/checks/items/properties/reasons"
              },
              "trace": {
                "$ref": "urn:dft-studio:analysis:sequential:2#/$defs/Report/properties/checks/items/properties/trace"
              },
              "logic": {
                "type": "object",
                "properties": {
                  "result": {
                    "$ref": "#/$defs/LogicValue"
                  },
                  "work": {
                    "$ref": "urn:dft-studio:analysis:sequential:2#/$defs/Report/properties/checks/items/properties/logic/properties/work"
                  },
                  "reasons": {
                    "$ref": "urn:dft-studio:analysis:sequential:2#/$defs/Report/properties/checks/items/properties/logic/properties/reasons"
                  },
                  "steps": {
                    "$ref": "urn:dft-studio:analysis:sequential:2#/$defs/Report/properties/checks/items/properties/logic/properties/steps"
                  },
                  "processes": {
                    "$ref": "urn:dft-studio:analysis:sequential:2#/$defs/Report/properties/checks/items/properties/logic/properties/processes"
                  },
                  "gates": {
                    "type": "array",
                    "items": {
                      "$ref": "#/$defs/Gate"
                    }
                  }
                },
                "required": [
                  "result",
                  "work",
                  "reasons",
                  "steps",
                  "processes",
                  "gates"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "point",
              "path",
              "verdict",
              "reasons"
            ],
            "additionalProperties": false
          }
        },
        "findings": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "rule": {
                "enum": [
                  "CLK-UNCTRL",
                  "RST-UNCTRL",
                  "CLK-GEN",
                  "RST-GEN",
                  "CLK-AS-DATA",
                  "CLK-GATED"
                ]
              },
              "severity": {
                "enum": [
                  "error",
                  "warning"
                ]
              },
              "check": {
                "type": "integer",
                "minimum": 0
              }
            },
            "required": [
              "rule",
              "severity",
              "check"
            ],
            "additionalProperties": false,
            "allOf": [
              {
                "if": {
                  "properties": {
                    "rule": {
                      "enum": [
                        "CLK-AS-DATA",
                        "CLK-GATED"
                      ]
                    }
                  }
                },
                "then": {
                  "properties": {
                    "severity": {
                      "const": "warning"
                    }
                  }
                },
                "else": {
                  "properties": {
                    "severity": {
                      "const": "error"
                    }
                  }
                }
              }
            ]
          }
        },
        "clockUsage": {
          "$ref": "urn:dft-studio:analysis:sequential:3#/$defs/Report/properties/clockUsage"
        },
        "clockRoots": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string"
              },
              "point": {
                "$ref": "urn:dft-studio:hier:protocol:2:schema:7#/$defs/TracePoint"
              }
            },
            "required": [
              "path",
              "point"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "formatVersion",
        "algorithm",
        "snapshot",
        "scope",
        "recursive",
        "limits",
        "quality",
        "visitedInstances",
        "registers",
        "checks",
        "findings",
        "clockRoots"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "limits": {
                "required": [
                  "maxUsageWork"
                ]
              }
            }
          },
          "then": {
            "required": [
              "clockUsage"
            ]
          },
          "else": {
            "not": {
              "required": [
                "clockUsage"
              ]
            }
          }
        }
      ]
    }
  }
}
