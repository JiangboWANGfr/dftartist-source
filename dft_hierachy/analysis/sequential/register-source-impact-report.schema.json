{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:dft-studio:analysis:register-source-impact:1",
  "oneOf": [
    {
      "$ref": "#/$defs/Report"
    },
    {
      "$ref": "urn:dft-studio:analysis:sequential:2#/$defs/Error"
    }
  ],
  "$defs": {
    "Report": {
      "type": "object",
      "properties": {
        "formatVersion": {
          "const": 1
        },
        "algorithm": {
          "const": "rtl-register-source-impact-v1"
        },
        "limits": {
          "type": "object",
          "properties": {
            "maxInstances": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100000
            },
            "maxDefinitions": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100000
            },
            "maxMembers": {
              "type": "integer",
              "minimum": 1,
              "maximum": 2000000
            },
            "maxInputMembers": {
              "type": "integer",
              "minimum": 1,
              "maximum": 2000000
            },
            "maxWork": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10000000
            },
            "maxMillis": {
              "type": "integer",
              "minimum": 1,
              "maximum": 60000
            }
          },
          "required": [
            "maxInstances",
            "maxDefinitions",
            "maxMembers",
            "maxInputMembers",
            "maxWork",
            "maxMillis"
          ],
          "additionalProperties": false
        },
        "quality": {
          "$ref": "urn:dft-studio:analysis:register-control-sources:1#/$defs/Report/properties/quality"
        },
        "analysis": {
          "$ref": "urn:dft-studio:analysis:register-source-transitions:1#/$defs/Report"
        },
        "work": {
          "type": "integer",
          "minimum": 0
        },
        "inputMembers": {
          "type": "integer",
          "minimum": 0
        },
        "instanceRows": {
          "type": "integer",
          "minimum": 0
        },
        "definitionRows": {
          "type": "integer",
          "minimum": 0
        },
        "members": {
          "type": "integer",
          "minimum": 0
        },
        "comparisons": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Comparison"
          },
          "minItems": 1,
          "maxItems": 7
        }
      },
      "required": [
        "formatVersion",
        "algorithm",
        "limits",
        "quality",
        "analysis",
        "work",
        "inputMembers",
        "instanceRows",
        "definitionRows",
        "members",
        "comparisons"
      ],
      "additionalProperties": false
    },
    "Member": {
      "type": "object",
      "properties": {
        "cohort": {
          "type": "integer",
          "minimum": 0
        },
        "member": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "cohort",
        "member"
      ],
      "additionalProperties": false
    },
    "Instance": {
      "type": "object",
      "properties": {
        "instance": {
          "type": "integer",
          "minimum": 0
        },
        "definition": {
          "type": "integer",
          "minimum": 0
        },
        "members": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Member"
          },
          "minItems": 1
        },
        "counts": {
          "$ref": "urn:dft-studio:analysis:register-source-attribution:1#/$defs/Counts"
        }
      },
      "required": [
        "instance",
        "definition",
        "members",
        "counts"
      ],
      "additionalProperties": false
    },
    "Definition": {
      "type": "object",
      "properties": {
        "definition": {
          "type": "integer",
          "minimum": 0
        },
        "instances": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "counts": {
          "$ref": "urn:dft-studio:analysis:register-source-attribution:1#/$defs/Counts"
        }
      },
      "required": [
        "definition",
        "instances",
        "counts"
      ],
      "additionalProperties": false
    },
    "Comparison": {
      "type": "object",
      "properties": {
        "scenario": {
          "type": "integer",
          "minimum": 1,
          "maximum": 7
        },
        "state": {
          "enum": [
            "complete",
            "partial",
            "not_run"
          ]
        },
        "inputCollected": {
          "type": "boolean"
        },
        "inputComplete": {
          "type": "boolean"
        },
        "sourcesComplete": {
          "type": "boolean"
        },
        "inputCohorts": {
          "type": "integer",
          "minimum": 0
        },
        "inputMembers": {
          "type": "integer",
          "minimum": 0
        },
        "instances": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Instance"
          }
        },
        "definitions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Definition"
          }
        },
        "totals": {
          "$ref": "urn:dft-studio:analysis:register-source-attribution:1#/$defs/Counts"
        }
      },
      "required": [
        "scenario",
        "state",
        "inputCollected",
        "inputComplete",
        "sourcesComplete",
        "inputCohorts",
        "inputMembers",
        "instances",
        "definitions",
        "totals"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "const": "complete"
              }
            }
          },
          "then": {
            "properties": {
              "inputCollected": {
                "const": true
              },
              "inputComplete": {
                "const": true
              },
              "sourcesComplete": {
                "const": true
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "inputCollected": {
                "const": false
              }
            }
          },
          "then": {
            "properties": {
              "inputMembers": {
                "const": 0
              },
              "instances": {
                "maxItems": 0
              },
              "definitions": {
                "maxItems": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "const": "not_run"
              }
            }
          },
          "then": {
            "properties": {
              "inputCollected": {
                "const": false
              }
            }
          }
        }
      ]
    }
  }
}
