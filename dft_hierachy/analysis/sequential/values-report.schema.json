{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:dft-studio:analysis:sequential:5",
  "title": "Explicit input-value conditional RTL sources v5",
  "oneOf": [
    {
      "$ref": "#/$defs/Report"
    },
    {
      "$ref": "urn:dft-studio:analysis:sequential:2#/$defs/Error"
    }
  ],
  "$defs": {
    "Report": {
      "type": "object",
      "properties": {
        "formatVersion": {
          "const": 5
        },
        "algorithm": {
          "const": "rtl-input-values-v1"
        },
        "snapshot": {
          "$ref": "urn:dft-studio:analysis:sequential:4#/$defs/Report/properties/snapshot"
        },
        "scope": {
          "$ref": "urn:dft-studio:analysis:sequential:4#/$defs/Report/properties/scope"
        },
        "recursive": {
          "$ref": "urn:dft-studio:analysis:sequential:4#/$defs/Report/properties/recursive"
        },
        "limits": {
          "$ref": "urn:dft-studio:analysis:sequential:4#/$defs/Report/properties/limits"
        },
        "quality": {
          "$ref": "urn:dft-studio:analysis:sequential:4#/$defs/Report/properties/quality"
        },
        "visitedInstances": {
          "$ref": "urn:dft-studio:analysis:sequential:4#/$defs/Report/properties/visitedInstances"
        },
        "registers": {
          "$ref": "urn:dft-studio:analysis:sequential:4#/$defs/Report/properties/registers"
        },
        "checks": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "point": {
                "$ref": "urn:dft-studio:analysis:sequential:4#/$defs/Report/properties/checks/items/properties/point"
              },
              "path": {
                "$ref": "urn:dft-studio:analysis:sequential:4#/$defs/Report/properties/checks/items/properties/path"
              },
              "verdict": {
                "$ref": "urn:dft-studio:analysis:sequential:4#/$defs/Report/properties/checks/items/properties/verdict"
              },
              "reasons": {
                "$ref": "urn:dft-studio:analysis:sequential:4#/$defs/Report/properties/checks/items/properties/reasons"
              },
              "trace": {
                "$ref": "urn:dft-studio:analysis:sequential:4#/$defs/Report/properties/checks/items/properties/trace"
              },
              "logic": {
                "type": "object",
                "properties": {
                  "result": {
                    "$ref": "urn:dft-studio:analysis:sequential:4#/$defs/Report/properties/checks/items/properties/logic/properties/result"
                  },
                  "work": {
                    "$ref": "urn:dft-studio:analysis:sequential:4#/$defs/Report/properties/checks/items/properties/logic/properties/work"
                  },
                  "reasons": {
                    "$ref": "urn:dft-studio:analysis:sequential:4#/$defs/Report/properties/checks/items/properties/logic/properties/reasons"
                  },
                  "steps": {
                    "$ref": "urn:dft-studio:analysis:sequential:4#/$defs/Report/properties/checks/items/properties/logic/properties/steps"
                  },
                  "processes": {
                    "$ref": "urn:dft-studio:analysis:sequential:4#/$defs/Report/properties/checks/items/properties/logic/properties/processes"
                  },
                  "gates": {
                    "$ref": "urn:dft-studio:analysis:sequential:4#/$defs/Report/properties/checks/items/properties/logic/properties/gates"
                  },
                  "appliedInputs": {
                    "type": "array",
                    "items": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 63
                    },
                    "uniqueItems": true
                  }
                },
                "required": [
                  "result",
                  "work",
                  "reasons",
                  "steps",
                  "processes",
                  "gates",
                  "appliedInputs"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "point",
              "path",
              "verdict",
              "reasons"
            ],
            "additionalProperties": false
          }
        },
        "findings": {
          "$ref": "urn:dft-studio:analysis:sequential:4#/$defs/Report/properties/findings"
        },
        "clockUsage": {
          "$ref": "urn:dft-studio:analysis:sequential:4#/$defs/Report/properties/clockUsage"
        },
        "clockRoots": {
          "type": "array",
          "minItems": 0,
          "maxItems": 64,
          "items": {
            "$ref": "urn:dft-studio:analysis:sequential:4#/$defs/Report/properties/clockRoots/items"
          }
        },
        "interpretation": {
          "const": "under_input_values"
        },
        "inputValues": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string"
              },
              "point": {
                "$ref": "urn:dft-studio:hier:protocol:2:schema:7#/$defs/TracePoint"
              },
              "value": {
                "enum": [
                  "0",
                  "1"
                ]
              }
            },
            "required": [
              "path",
              "point",
              "value"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "formatVersion",
        "algorithm",
        "snapshot",
        "scope",
        "recursive",
        "limits",
        "quality",
        "visitedInstances",
        "registers",
        "checks",
        "findings",
        "clockRoots",
        "interpretation",
        "inputValues"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "limits": {
                "required": [
                  "maxUsageWork"
                ]
              }
            }
          },
          "then": {
            "required": [
              "clockUsage"
            ]
          },
          "else": {
            "not": {
              "required": [
                "clockUsage"
              ]
            }
          }
        }
      ]
    }
  }
}
