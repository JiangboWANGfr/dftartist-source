{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:dft-studio:analysis:register-control-sources:1",
  "oneOf": [
    {
      "$ref": "#/$defs/Report"
    },
    {
      "$ref": "urn:dft-studio:analysis:sequential:2#/$defs/Error"
    }
  ],
  "$defs": {
    "Report": {
      "type": "object",
      "properties": {
        "formatVersion": {
          "const": 1
        },
        "algorithm": {
          "const": "rtl-register-control-sources-v1"
        },
        "snapshotId": {
          "type": "string"
        },
        "scope": {
          "type": "string"
        },
        "limits": {
          "type": "object",
          "properties": {
            "maxRows": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10000
            },
            "maxSources": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10000
            },
            "maxMembers": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000000
            },
            "maxSegments": {
              "type": "integer",
              "minimum": 1,
              "maximum": 2000000
            },
            "maxOverlapMembers": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000000
            },
            "maxWork": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10000000
            },
            "maxMillis": {
              "type": "integer",
              "minimum": 1,
              "maximum": 60000
            }
          },
          "required": [
            "maxRows",
            "maxSources",
            "maxMembers",
            "maxSegments",
            "maxOverlapMembers",
            "maxWork",
            "maxMillis"
          ],
          "additionalProperties": false
        },
        "quality": {
          "$ref": "urn:dft-studio:analysis:register-control-profile:1#/$defs/Report/properties/quality"
        },
        "analysis": {
          "$ref": "urn:dft-studio:analysis:register-control-fanout:1#/$defs/Report"
        },
        "inputNodes": {
          "type": "integer",
          "minimum": 0
        },
        "work": {
          "type": "integer",
          "minimum": 0
        },
        "memberFacts": {
          "type": "integer",
          "minimum": 0
        },
        "segmentCount": {
          "type": "integer",
          "minimum": 0
        },
        "overlapMembers": {
          "type": "integer",
          "minimum": 0
        },
        "attributionSignals": {
          "type": "integer",
          "minimum": 0
        },
        "checkedSignals": {
          "type": "integer",
          "minimum": 0
        },
        "crossGroupBits": {
          "type": "integer",
          "minimum": 0
        },
        "attributionsComplete": {
          "type": "boolean"
        },
        "rows": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "node": {
                "type": "integer",
                "minimum": 0
              },
              "kind": {
                "enum": [
                  "primary_input",
                  "constant",
                  "undriven",
                  "generated",
                  "unresolved"
                ]
              },
              "group": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0
              }
            },
            "required": [
              "node",
              "kind",
              "group"
            ],
            "additionalProperties": false,
            "allOf": [
              {
                "if": {
                  "properties": {
                    "kind": {
                      "enum": [
                        "generated",
                        "unresolved"
                      ]
                    }
                  }
                },
                "then": {
                  "properties": {
                    "group": {
                      "type": "null"
                    }
                  }
                },
                "else": {
                  "properties": {
                    "group": {
                      "type": "integer",
                      "minimum": 0
                    }
                  }
                }
              }
            ]
          }
        },
        "groups": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "source": {
                "allOf": [
                  {
                    "$ref": "urn:dft-studio:analysis:register-control-profile:1#/$defs/Report/properties/checks/items/properties/source"
                  },
                  {
                    "properties": {
                      "kind": {
                        "enum": [
                          "primary_input",
                          "constant",
                          "undriven"
                        ]
                      }
                    }
                  }
                ]
              },
              "nodes": {
                "type": "array",
                "items": {
                  "type": "integer",
                  "minimum": 0
                },
                "minItems": 1
              },
              "rawGroups": {
                "type": "array",
                "items": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "membersComplete": {
                "type": "boolean"
              },
              "reasons": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "signals": {
                "$ref": "urn:dft-studio:analysis:register-scenarios:1#/$defs/Report/properties/comparisons/items/properties/changedSignals"
              },
              "totals": {
                "$ref": "urn:dft-studio:analysis:register-statistics:1#/$defs/Report/properties/totals"
              }
            },
            "required": [
              "source",
              "nodes",
              "rawGroups",
              "membersComplete",
              "reasons",
              "signals",
              "totals"
            ],
            "additionalProperties": false
          }
        },
        "attributions": {
          "$ref": "urn:dft-studio:analysis:register-event-groups:1#/$defs/Report/properties/attributions"
        },
        "summary": {
          "type": "object",
          "properties": {
            "rows": {
              "type": "integer",
              "minimum": 0
            },
            "terminalNodes": {
              "type": "integer",
              "minimum": 0
            },
            "generatedNodes": {
              "type": "integer",
              "minimum": 0
            },
            "unresolvedNodes": {
              "type": "integer",
              "minimum": 0
            },
            "sources": {
              "type": "integer",
              "minimum": 0
            },
            "partialSources": {
              "type": "integer",
              "minimum": 0
            },
            "sourceSignals": {
              "type": "integer",
              "minimum": 0
            },
            "summarizedSourceSignals": {
              "type": "integer",
              "minimum": 0
            },
            "attributions": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "rows",
            "terminalNodes",
            "generatedNodes",
            "unresolvedNodes",
            "sources",
            "partialSources",
            "sourceSignals",
            "summarizedSourceSignals",
            "attributions"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "formatVersion",
        "algorithm",
        "snapshotId",
        "scope",
        "limits",
        "quality",
        "analysis",
        "inputNodes",
        "work",
        "memberFacts",
        "segmentCount",
        "overlapMembers",
        "attributionSignals",
        "checkedSignals",
        "crossGroupBits",
        "attributionsComplete",
        "rows",
        "groups",
        "attributions",
        "summary"
      ],
      "additionalProperties": false
    }
  }
}
