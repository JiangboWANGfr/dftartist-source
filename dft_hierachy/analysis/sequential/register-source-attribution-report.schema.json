{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:dft-studio:analysis:register-source-attribution:1",
  "oneOf": [
    {
      "$ref": "#/$defs/Report"
    },
    {
      "$ref": "urn:dft-studio:analysis:sequential:2#/$defs/Error"
    }
  ],
  "$defs": {
    "Report": {
      "type": "object",
      "properties": {
        "formatVersion": {
          "const": 1
        },
        "algorithm": {
          "const": "rtl-register-source-attribution-v1"
        },
        "limits": {
          "type": "object",
          "properties": {
            "maxRows": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100000
            },
            "maxIntervals": {
              "type": "integer",
              "minimum": 1,
              "maximum": 2000000
            },
            "maxSegments": {
              "type": "integer",
              "minimum": 1,
              "maximum": 2000000
            },
            "maxMembers": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10000000
            },
            "maxWork": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10000000
            },
            "maxMillis": {
              "type": "integer",
              "minimum": 1,
              "maximum": 60000
            }
          },
          "required": [
            "maxRows",
            "maxIntervals",
            "maxSegments",
            "maxMembers",
            "maxWork",
            "maxMillis"
          ],
          "additionalProperties": false
        },
        "quality": {
          "$ref": "urn:dft-studio:analysis:register-control-sources:1#/$defs/Report/properties/quality"
        },
        "analysis": {
          "$ref": "urn:dft-studio:analysis:register-source-deltas:1#/$defs/Report"
        },
        "work": {
          "type": "integer",
          "minimum": 0
        },
        "intervals": {
          "type": "integer",
          "minimum": 0
        },
        "rows": {
          "type": "integer",
          "minimum": 0
        },
        "segments": {
          "type": "integer",
          "minimum": 0
        },
        "members": {
          "type": "integer",
          "minimum": 0
        },
        "comparisons": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Comparison"
          },
          "minItems": 1,
          "maxItems": 7
        }
      },
      "required": [
        "formatVersion",
        "algorithm",
        "limits",
        "quality",
        "analysis",
        "work",
        "intervals",
        "rows",
        "segments",
        "members",
        "comparisons"
      ],
      "additionalProperties": false
    },
    "Counts": {
      "type": "object",
      "properties": {
        "coveredBits": {
          "type": "integer",
          "minimum": 0
        },
        "changedBits": {
          "type": "integer",
          "minimum": 0
        },
        "retainedOnlyBits": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "coveredBits",
        "changedBits",
        "retainedOnlyBits"
      ],
      "additionalProperties": false
    },
    "Segment": {
      "type": "object",
      "properties": {
        "bits": {
          "$ref": "urn:dft-studio:hier:protocol:2:schema:7#/$defs/BitRange"
        },
        "addedRows": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          },
          "uniqueItems": true
        },
        "removedRows": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          },
          "uniqueItems": true
        },
        "retainedRows": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          },
          "uniqueItems": true
        }
      },
      "required": [
        "bits",
        "addedRows",
        "removedRows",
        "retainedRows"
      ],
      "additionalProperties": false
    },
    "Row": {
      "type": "object",
      "properties": {
        "signal": {
          "type": "integer",
          "minimum": 0
        },
        "segments": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Segment"
          },
          "minItems": 1
        },
        "counts": {
          "$ref": "#/$defs/Counts"
        }
      },
      "required": [
        "signal",
        "segments",
        "counts"
      ],
      "additionalProperties": false
    },
    "Comparison": {
      "type": "object",
      "properties": {
        "scenario": {
          "type": "integer",
          "minimum": 1,
          "maximum": 7
        },
        "state": {
          "enum": [
            "complete",
            "partial",
            "not_run"
          ]
        },
        "inputCollected": {
          "type": "boolean"
        },
        "sourcesComplete": {
          "type": "boolean"
        },
        "resolvedRows": {
          "type": "integer",
          "minimum": 0
        },
        "unresolvedRows": {
          "type": "integer",
          "minimum": 0
        },
        "missingRows": {
          "type": "integer",
          "minimum": 0
        },
        "rows": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Row"
          }
        },
        "totals": {
          "$ref": "#/$defs/Counts"
        }
      },
      "required": [
        "scenario",
        "state",
        "inputCollected",
        "sourcesComplete",
        "resolvedRows",
        "unresolvedRows",
        "missingRows",
        "rows",
        "totals"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "const": "complete"
              }
            }
          },
          "then": {
            "properties": {
              "inputCollected": {
                "const": true
              },
              "sourcesComplete": {
                "const": true
              },
              "unresolvedRows": {
                "const": 0
              },
              "missingRows": {
                "const": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "inputCollected": {
                "const": false
              }
            }
          },
          "then": {
            "properties": {
              "sourcesComplete": {
                "const": false
              },
              "rows": {
                "maxItems": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "const": "not_run"
              }
            }
          },
          "then": {
            "properties": {
              "inputCollected": {
                "const": false
              },
              "sourcesComplete": {
                "const": false
              },
              "rows": {
                "maxItems": 0
              }
            }
          }
        }
      ]
    }
  }
}
