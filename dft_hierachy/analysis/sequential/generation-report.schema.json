{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:dft-studio:analysis:control-generation:1",
  "oneOf": [
    {
      "$ref": "#/$defs/Report"
    },
    {
      "$ref": "urn:dft-studio:analysis:sequential:2#/$defs/Error"
    }
  ],
  "$defs": {
    "Node": {
      "type": "object",
      "properties": {
        "point": {
          "$ref": "urn:dft-studio:hier:protocol:2:schema:7#/$defs/TracePoint"
        },
        "path": {
          "type": "string"
        },
        "depth": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000
        },
        "originalCheck": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 9999
        },
        "generator": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 9999
        },
        "reasons": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "source": {
          "$ref": "urn:dft-studio:analysis:scenarios:1#/$defs/Source"
        },
        "control": {
          "anyOf": [
            {
              "$ref": "urn:dft-studio:analysis:sequential:2#/$defs/Report/properties/checks/items"
            },
            {
              "$ref": "urn:dft-studio:analysis:sequential:4#/$defs/Report/properties/checks/items"
            },
            {
              "$ref": "urn:dft-studio:analysis:sequential:5#/$defs/Report/properties/checks/items"
            }
          ]
        }
      },
      "required": [
        "point",
        "path",
        "depth",
        "originalCheck",
        "generator",
        "reasons"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "originalCheck": {
                "type": "null"
              }
            }
          },
          "then": {
            "required": [
              "control"
            ]
          },
          "else": {
            "not": {
              "required": [
                "control"
              ]
            }
          }
        }
      ]
    },
    "Generator": {
      "type": "object",
      "properties": {
        "fact": {
          "$ref": "urn:dft-studio:hier:protocol:2:schema:7#/$defs/RegisterInfo"
        },
        "instancePath": {
          "type": "string"
        },
        "signalPath": {
          "type": "string"
        },
        "lookup": {
          "type": "object",
          "properties": {
            "page": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100000
            },
            "item": {
              "type": "integer",
              "minimum": 0,
              "maximum": 63
            }
          },
          "required": [
            "page",
            "item"
          ],
          "additionalProperties": false
        },
        "clockNode": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 9999
        },
        "asyncNodes": {
          "type": "array",
          "items": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0,
            "maximum": 9999
          },
          "maxItems": 10000000
        },
        "expanded": {
          "type": "boolean"
        }
      },
      "required": [
        "fact",
        "instancePath",
        "signalPath",
        "lookup",
        "clockNode",
        "asyncNodes",
        "expanded"
      ],
      "additionalProperties": false
    },
    "RegisterPage": {
      "type": "object",
      "properties": {
        "instance": {
          "type": "string"
        },
        "cursor": {
          "type": "string"
        },
        "response": {
          "type": "object",
          "properties": {
            "result": {
              "$ref": "urn:dft-studio:hier:protocol:2:schema:7#/$defs/RegisterInfoPage"
            },
            "completeness": {
              "$ref": "urn:dft-studio:hier:protocol:2:schema:7#/$defs/Completeness"
            }
          },
          "required": [
            "result",
            "completeness"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "instance",
        "cursor",
        "response"
      ],
      "additionalProperties": false
    },
    "Graph": {
      "type": "object",
      "properties": {
        "scenario": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 7
        },
        "snapshotId": {
          "type": "string"
        },
        "scope": {
          "type": "string"
        },
        "quality": {
          "type": "object",
          "properties": {
            "completeness": {
              "enum": [
                "complete",
                "partial"
              ]
            },
            "reasons": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "uniqueItems": true
            }
          },
          "required": [
            "completeness",
            "reasons"
          ],
          "additionalProperties": false
        },
        "inputChecks": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        },
        "work": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000000
        },
        "registerFacts": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000
        },
        "traceNodes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        },
        "traceEdges": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4000000
        },
        "logicWork": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        },
        "seeds": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "check": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9999
              },
              "node": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9999
              }
            },
            "required": [
              "check",
              "node"
            ],
            "additionalProperties": false
          },
          "maxItems": 10000
        },
        "nodes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Node"
          },
          "maxItems": 10000
        },
        "generators": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Generator"
          },
          "maxItems": 10000
        },
        "registerPages": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/RegisterPage"
          },
          "maxItems": 100000
        },
        "cycles": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "generators": {
                "type": "array",
                "items": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9999
                },
                "minItems": 2,
                "maxItems": 10001
              },
              "controls": {
                "type": "array",
                "items": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9999
                },
                "minItems": 1,
                "maxItems": 10000
              }
            },
            "required": [
              "generators",
              "controls"
            ],
            "additionalProperties": false
          },
          "maxItems": 1000
        }
      },
      "required": [
        "scenario",
        "snapshotId",
        "scope",
        "quality",
        "inputChecks",
        "work",
        "registerFacts",
        "traceNodes",
        "traceEdges",
        "logicWork",
        "seeds",
        "nodes",
        "generators",
        "registerPages",
        "cycles"
      ],
      "additionalProperties": false
    },
    "Report": {
      "type": "object",
      "properties": {
        "formatVersion": {
          "const": 1
        },
        "algorithm": {
          "const": "rtl-control-generation-v1"
        },
        "limits": {
          "type": "object",
          "properties": {
            "maxControls": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10000
            },
            "maxGenerators": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10000
            },
            "maxRegisterFacts": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100000
            },
            "maxWork": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10000000
            },
            "maxDepth": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000
            },
            "maxCycles": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000
            },
            "maxMillis": {
              "type": "integer",
              "minimum": 1,
              "maximum": 60000
            },
            "maxTraceNodes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000000
            },
            "maxTraceEdges": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4000000
            },
            "maxLogicWork": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000000
            }
          },
          "required": [
            "maxControls",
            "maxGenerators",
            "maxRegisterFacts",
            "maxWork",
            "maxDepth",
            "maxCycles",
            "maxMillis",
            "maxTraceNodes",
            "maxTraceEdges",
            "maxLogicWork"
          ],
          "additionalProperties": false
        },
        "quality": {
          "type": "object",
          "properties": {
            "completeness": {
              "enum": [
                "complete",
                "partial"
              ]
            },
            "reasons": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "uniqueItems": true
            }
          },
          "required": [
            "completeness",
            "reasons"
          ],
          "additionalProperties": false
        },
        "analysis": {
          "oneOf": [
            {
              "$ref": "urn:dft-studio:analysis:sequential:1#/$defs/Report"
            },
            {
              "$ref": "urn:dft-studio:analysis:sequential:2#/$defs/Report"
            },
            {
              "$ref": "urn:dft-studio:analysis:sequential:3#/$defs/Report"
            },
            {
              "$ref": "urn:dft-studio:analysis:sequential:4#/$defs/Report"
            },
            {
              "$ref": "urn:dft-studio:analysis:sequential:5#/$defs/Report"
            },
            {
              "$ref": "urn:dft-studio:analysis:scenarios:1#/$defs/Report"
            },
            {
              "$ref": "urn:dft-studio:analysis:source-inventory:1#/$defs/Report"
            }
          ]
        },
        "graphs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Graph"
          },
          "maxItems": 8
        },
        "summary": {
          "type": "object",
          "properties": {
            "graphs": {
              "type": "integer",
              "minimum": 0,
              "maximum": 8
            },
            "nodeEntries": {
              "type": "integer",
              "minimum": 0,
              "maximum": 80000
            },
            "generatorEntries": {
              "type": "integer",
              "minimum": 0,
              "maximum": 80000
            },
            "cycleEntries": {
              "type": "integer",
              "minimum": 0,
              "maximum": 8000
            }
          },
          "required": [
            "graphs",
            "nodeEntries",
            "generatorEntries",
            "cycleEntries"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "formatVersion",
        "algorithm",
        "limits",
        "quality",
        "analysis",
        "graphs",
        "summary"
      ],
      "additionalProperties": false
    }
  }
}
