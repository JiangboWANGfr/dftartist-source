{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:dft-studio:analysis:register-source-hierarchy-ranges:1",
  "oneOf": [
    {
      "$ref": "#/$defs/Report"
    },
    {
      "$ref": "urn:dft-studio:analysis:sequential:2#/$defs/Error"
    }
  ],
  "$defs": {
    "Report": {
      "type": "object",
      "properties": {
        "formatVersion": {
          "const": 1
        },
        "algorithm": {
          "const": "rtl-register-source-hierarchy-ranges-v1"
        },
        "limits": {
          "type": "object",
          "properties": {
            "maxRows": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100000
            },
            "maxSignals": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000000
            },
            "maxRanges": {
              "type": "integer",
              "minimum": 1,
              "maximum": 2000000
            },
            "maxMembers": {
              "type": "integer",
              "minimum": 1,
              "maximum": 2000000
            },
            "maxWork": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10000000
            },
            "maxMillis": {
              "type": "integer",
              "minimum": 1,
              "maximum": 60000
            }
          },
          "required": [
            "maxRows",
            "maxSignals",
            "maxRanges",
            "maxMembers",
            "maxWork",
            "maxMillis"
          ],
          "additionalProperties": false
        },
        "quality": {
          "$ref": "urn:dft-studio:analysis:register-control-sources:1#/$defs/Report/properties/quality"
        },
        "analysis": {
          "$ref": "urn:dft-studio:analysis:register-source-hierarchy-matrix:1#/$defs/Report"
        },
        "work": {
          "type": "integer",
          "minimum": 0
        },
        "rows": {
          "type": "integer",
          "minimum": 0
        },
        "signals": {
          "type": "integer",
          "minimum": 0
        },
        "ranges": {
          "type": "integer",
          "minimum": 0
        },
        "members": {
          "type": "integer",
          "minimum": 0
        },
        "comparisons": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Comparison"
          },
          "minItems": 1,
          "maxItems": 7
        }
      },
      "required": [
        "formatVersion",
        "algorithm",
        "limits",
        "quality",
        "analysis",
        "work",
        "rows",
        "signals",
        "ranges",
        "members",
        "comparisons"
      ],
      "additionalProperties": false
    },
    "Signal": {
      "type": "object",
      "properties": {
        "signal": {
          "type": "integer",
          "minimum": 0
        },
        "added": {
          "type": "array",
          "items": {
            "$ref": "urn:dft-studio:hier:protocol:2:schema:7#/$defs/BitRange"
          }
        },
        "removed": {
          "type": "array",
          "items": {
            "$ref": "urn:dft-studio:hier:protocol:2:schema:7#/$defs/BitRange"
          }
        },
        "retained": {
          "type": "array",
          "items": {
            "$ref": "urn:dft-studio:hier:protocol:2:schema:7#/$defs/BitRange"
          }
        },
        "counts": {
          "$ref": "urn:dft-studio:analysis:register-source-deltas:1#/$defs/Counts"
        },
        "members": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          },
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "required": [
        "signal",
        "added",
        "removed",
        "retained",
        "counts",
        "members"
      ],
      "additionalProperties": false,
      "anyOf": [
        {
          "properties": {
            "added": {
              "minItems": 1
            }
          }
        },
        {
          "properties": {
            "removed": {
              "minItems": 1
            }
          }
        },
        {
          "properties": {
            "retained": {
              "minItems": 1
            }
          }
        }
      ]
    },
    "Row": {
      "type": "object",
      "properties": {
        "matrixRow": {
          "type": "integer",
          "minimum": 0
        },
        "signals": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Signal"
          },
          "minItems": 1
        }
      },
      "required": [
        "matrixRow",
        "signals"
      ],
      "additionalProperties": false
    },
    "Comparison": {
      "type": "object",
      "properties": {
        "scenario": {
          "type": "integer",
          "minimum": 1,
          "maximum": 7
        },
        "state": {
          "enum": [
            "complete",
            "partial",
            "not_run"
          ]
        },
        "inputComplete": {
          "type": "boolean"
        },
        "sourcesComplete": {
          "type": "boolean"
        },
        "inputRows": {
          "type": "integer",
          "minimum": 0
        },
        "rows": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Row"
          }
        }
      },
      "required": [
        "scenario",
        "state",
        "inputComplete",
        "sourcesComplete",
        "inputRows",
        "rows"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "const": "complete"
              }
            }
          },
          "then": {
            "properties": {
              "inputComplete": {
                "const": true
              },
              "sourcesComplete": {
                "const": true
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "const": "not_run"
              }
            }
          },
          "then": {
            "properties": {
              "rows": {
                "maxItems": 0
              }
            }
          }
        }
      ]
    }
  }
}
