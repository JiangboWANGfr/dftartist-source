{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:dft-studio:analysis:register-source-hierarchy-matrix:1",
  "oneOf": [
    {
      "$ref": "#/$defs/Report"
    },
    {
      "$ref": "urn:dft-studio:analysis:sequential:2#/$defs/Error"
    }
  ],
  "$defs": {
    "Report": {
      "type": "object",
      "properties": {
        "formatVersion": {
          "const": 1
        },
        "algorithm": {
          "const": "rtl-register-source-hierarchy-matrix-v1"
        },
        "limits": {
          "type": "object",
          "properties": {
            "maxRows": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100000
            },
            "maxMembers": {
              "type": "integer",
              "minimum": 1,
              "maximum": 2000000
            },
            "maxInputNodes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100000
            },
            "maxInputMembers": {
              "type": "integer",
              "minimum": 1,
              "maximum": 2000000
            },
            "maxWork": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10000000
            },
            "maxMillis": {
              "type": "integer",
              "minimum": 1,
              "maximum": 60000
            }
          },
          "required": [
            "maxRows",
            "maxMembers",
            "maxInputNodes",
            "maxInputMembers",
            "maxWork",
            "maxMillis"
          ],
          "additionalProperties": false
        },
        "quality": {
          "$ref": "urn:dft-studio:analysis:register-control-sources:1#/$defs/Report/properties/quality"
        },
        "analysis": {
          "$ref": "urn:dft-studio:analysis:register-source-hierarchy:1#/$defs/Report"
        },
        "work": {
          "type": "integer",
          "minimum": 0
        },
        "inputNodes": {
          "type": "integer",
          "minimum": 0
        },
        "inputMembers": {
          "type": "integer",
          "minimum": 0
        },
        "rows": {
          "type": "integer",
          "minimum": 0
        },
        "members": {
          "type": "integer",
          "minimum": 0
        },
        "comparisons": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Comparison"
          },
          "minItems": 1,
          "maxItems": 7
        }
      },
      "required": [
        "formatVersion",
        "algorithm",
        "limits",
        "quality",
        "analysis",
        "work",
        "inputNodes",
        "inputMembers",
        "rows",
        "members",
        "comparisons"
      ],
      "additionalProperties": false
    },
    "Row": {
      "type": "object",
      "properties": {
        "source": {
          "type": "integer",
          "minimum": 0
        },
        "node": {
          "type": "integer",
          "minimum": 0
        },
        "members": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Member"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "counts": {
          "$ref": "urn:dft-studio:analysis:register-source-deltas:1#/$defs/Counts"
        }
      },
      "required": [
        "source",
        "node",
        "members",
        "counts"
      ],
      "additionalProperties": false
    },
    "Member": {
      "type": "object",
      "properties": {
        "row": {
          "type": "integer",
          "minimum": 0
        },
        "segment": {
          "type": "integer",
          "minimum": 0
        },
        "role": {
          "enum": [
            "added",
            "removed",
            "retained"
          ]
        }
      },
      "required": [
        "row",
        "segment",
        "role"
      ],
      "additionalProperties": false
    },
    "Comparison": {
      "type": "object",
      "properties": {
        "scenario": {
          "type": "integer",
          "minimum": 1,
          "maximum": 7
        },
        "state": {
          "enum": [
            "complete",
            "partial",
            "not_run"
          ]
        },
        "inputCollected": {
          "type": "boolean"
        },
        "inputComplete": {
          "type": "boolean"
        },
        "sourcesComplete": {
          "type": "boolean"
        },
        "inputNodes": {
          "type": "integer",
          "minimum": 0
        },
        "inputMembers": {
          "type": "integer",
          "minimum": 0
        },
        "rows": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Row"
          }
        }
      },
      "required": [
        "scenario",
        "state",
        "inputCollected",
        "inputComplete",
        "sourcesComplete",
        "inputNodes",
        "inputMembers",
        "rows"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "const": "complete"
              }
            }
          },
          "then": {
            "properties": {
              "inputCollected": {
                "const": true
              },
              "inputComplete": {
                "const": true
              },
              "sourcesComplete": {
                "const": true
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "inputCollected": {
                "const": false
              }
            }
          },
          "then": {
            "properties": {
              "rows": {
                "maxItems": 0
              },
              "inputMembers": {
                "const": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "const": "not_run"
              }
            }
          },
          "then": {
            "properties": {
              "inputCollected": {
                "const": false
              }
            }
          }
        }
      ]
    }
  }
}
