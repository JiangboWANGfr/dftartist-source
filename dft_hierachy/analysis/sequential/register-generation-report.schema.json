{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:dft-studio:analysis:register-control-generation:1",
  "oneOf": [
    {
      "$ref": "#/$defs/Report"
    },
    {
      "$ref": "urn:dft-studio:analysis:sequential:2#/$defs/Error"
    }
  ],
  "$defs": {
    "Report": {
      "type": "object",
      "properties": {
        "formatVersion": {
          "const": 1
        },
        "algorithm": {
          "const": "rtl-register-control-generation-v1"
        },
        "limits": {
          "type": "object",
          "properties": {
            "generation": {
              "$ref": "urn:dft-studio:analysis:control-generation:1#/$defs/Report/properties/limits"
            },
            "maxEvents": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000000
            },
            "maxWork": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10000000
            },
            "maxMillis": {
              "type": "integer",
              "minimum": 1,
              "maximum": 60000
            }
          },
          "required": [
            "generation",
            "maxEvents",
            "maxWork",
            "maxMillis"
          ],
          "additionalProperties": false
        },
        "quality": {
          "$ref": "urn:dft-studio:analysis:register-control-profile:1#/$defs/Report/properties/quality"
        },
        "analysis": {
          "allOf": [
            {
              "$ref": "urn:dft-studio:analysis:register-control-profile:1#/$defs/Report"
            },
            {
              "properties": {
                "options": {
                  "properties": {
                    "resolveLogic": {
                      "const": true
                    }
                  }
                }
              }
            }
          ]
        },
        "graph": {
          "allOf": [
            {
              "$ref": "urn:dft-studio:analysis:control-generation:1#/$defs/Graph"
            },
            {
              "properties": {
                "scenario": {
                  "type": "null"
                }
              }
            }
          ]
        },
        "mappingComplete": {
          "type": "boolean"
        },
        "inputEvents": {
          "type": "integer",
          "minimum": 0
        },
        "work": {
          "type": "integer",
          "minimum": 0
        },
        "events": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "rawGroup": {
                "type": "integer",
                "minimum": 0
              },
              "role": {
                "enum": [
                  "clock",
                  "async"
                ]
              },
              "asyncIndex": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0
              },
              "check": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0
              },
              "node": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0
              },
              "reasons": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "required": [
              "rawGroup",
              "role",
              "asyncIndex",
              "check",
              "node",
              "reasons"
            ],
            "additionalProperties": false,
            "allOf": [
              {
                "if": {
                  "properties": {
                    "role": {
                      "const": "clock"
                    }
                  }
                },
                "then": {
                  "properties": {
                    "asyncIndex": {
                      "type": "null"
                    }
                  }
                },
                "else": {
                  "properties": {
                    "asyncIndex": {
                      "type": "integer",
                      "minimum": 0
                    }
                  }
                }
              },
              {
                "if": {
                  "properties": {
                    "check": {
                      "type": "null"
                    }
                  }
                },
                "then": {
                  "properties": {
                    "node": {
                      "type": "null"
                    }
                  }
                }
              }
            ]
          }
        },
        "summary": {
          "type": "object",
          "properties": {
            "inputEvents": {
              "type": "integer",
              "minimum": 0
            },
            "eventRows": {
              "type": "integer",
              "minimum": 0
            },
            "mappedEvents": {
              "type": "integer",
              "minimum": 0
            },
            "unmappedEvents": {
              "type": "integer",
              "minimum": 0
            },
            "nodes": {
              "type": "integer",
              "minimum": 0
            },
            "generators": {
              "type": "integer",
              "minimum": 0
            },
            "cycles": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "inputEvents",
            "eventRows",
            "mappedEvents",
            "unmappedEvents",
            "nodes",
            "generators",
            "cycles"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "formatVersion",
        "algorithm",
        "limits",
        "quality",
        "analysis",
        "graph",
        "mappingComplete",
        "inputEvents",
        "work",
        "events",
        "summary"
      ],
      "additionalProperties": false
    }
  }
}
