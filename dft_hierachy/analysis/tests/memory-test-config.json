{
  "formatVersion": 1,
  "kind": "memory-test-config",
  "rules": [
    {
      "path": [
        "schedule_top"
      ],
      "recursive": true,
      "clockDomain": "a",
      "partition": ""
    },
    {
      "path": [
        "schedule_top",
        "b0"
      ],
      "recursive": false,
      "clockDomain": "b",
      "partition": ""
    },
    {
      "path": [
        "schedule_top",
        "b1"
      ],
      "recursive": false,
      "clockDomain": "b",
      "partition": ""
    },
    {
      "path": [
        "schedule_top",
        "c0"
      ],
      "recursive": false,
      "clockDomain": "c",
      "partition": ""
    },
    {
      "path": [
        "schedule_top",
        "d0"
      ],
      "recursive": false,
      "clockDomain": "d",
      "partition": ""
    }
  ],
  "planning": {
    "policy": {
      "maxParallelMemories": 2
    }
  },
  "scheduling": {
    "policy": {
      "maxParallelControllers": 2,
      "maxPowerMicrowatts": 300000
    }
  },
  "timing": {
    "clocks": [
      {
        "clockDomain": "a",
        "periodPicoseconds": 1000
      },
      {
        "clockDomain": "b",
        "periodPicoseconds": 2000
      },
      {
        "clockDomain": "c",
        "periodPicoseconds": 3000
      },
      {
        "clockDomain": "d",
        "periodPicoseconds": 4000
      }
    ],
    "policy": {
      "waveOverheadPicoseconds": 7
    }
  }
}
