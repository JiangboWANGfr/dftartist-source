include_guard(GLOBAL)
include(GNUInstallDirs)
include("${CMAKE_CURRENT_LIST_DIR}/Text.cmake")

function(_dft_cli_normal_path value output)
  set(_path "${value}")
  cmake_path(NORMAL_PATH _path)
  string(REGEX REPLACE "/+$" "" _path "${_path}")
  if(_path STREQUAL "")
    set(_path ".")
  endif()
  set(${output} "${_path}" PARENT_SCOPE)
endfunction()

# A component owns its data tree and manifest; native targets may be shared.
function(dft_install_cli_component)
  cmake_parse_arguments(CLI "" "NAME;DATA;FORMAT;KIND;MATERIALS" "TARGETS;SCHEMAS;EXAMPLES" ${ARGN})
  get_filename_component(_cli_root "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/.." ABSOLUTE)
  get_filename_component(_cli_protocol "${_cli_root}/../protocol/schema/hier.schema.json" ABSOLUTE)
  set(_cli_common "${_cli_root}/wrapper/packaging")
  foreach(_field CMAKE_INSTALL_BINDIR CMAKE_INSTALL_DATADIR CMAKE_SYSTEM_NAME CMAKE_SYSTEM_PROCESSOR CMAKE_BUILD_TYPE)
    _dft_cli_validate_text("${${_field}}" "${_field}")
  endforeach()
  foreach(_config IN LISTS CMAKE_CONFIGURATION_TYPES)
    _dft_cli_validate_text("${_config}" "configuration name")
  endforeach()
  foreach(_dir CMAKE_INSTALL_BINDIR CMAKE_INSTALL_DATADIR)
    if(IS_ABSOLUTE "${${_dir}}" OR "${${_dir}}" MATCHES "(^|/)\\.\\.(/|$)|[\\\\\";$\n\r]" OR "${${_dir}}" STREQUAL "")
      message(FATAL_ERROR "${CLI_NAME} requires a relative ${_dir} without parent traversal or CMake control characters")
    endif()
    # Reject traversal before normalizing: x/../y must not become an accepted y.
    _dft_cli_normal_path("${${_dir}}" _normal)
    if(_normal MATCHES "^[^/]*:")
      message(FATAL_ERROR "${CLI_NAME} requires a relative ${_dir} without a drive prefix")
    endif()
    set(${_dir} "${_normal}")
  endforeach()
  set(_cli_share "${CMAKE_INSTALL_DATADIR}/${CLI_DATA}")
  _dft_cli_normal_path("${_cli_share}" _cli_share)
  set(_cli_executables "")
  foreach(_target IN LISTS CLI_TARGETS)
    install(TARGETS ${_target} RUNTIME DESTINATION "${CMAKE_INSTALL_BINDIR}" COMPONENT ${CLI_NAME})
    list(APPEND _cli_executables "${CMAKE_INSTALL_BINDIR}/$<TARGET_FILE_NAME:${_target}>")
  endforeach()
  set(_cli_payload ${_cli_executables})
  foreach(_file IN LISTS CLI_SCHEMAS)
    get_filename_component(_file "${_file}" ABSOLUTE)
    if(_file STREQUAL _cli_protocol)
      set(_rel "protocol/hier.schema.json")
    else()
      file(RELATIVE_PATH _rel "${_cli_root}" "${_file}")
    endif()
    get_filename_component(_sub "${_rel}" DIRECTORY)
    install(FILES "${_file}" DESTINATION "${_cli_share}/schemas/${_sub}" COMPONENT ${CLI_NAME})
    list(APPEND _cli_payload "${_cli_share}/schemas/${_rel}")
  endforeach()
  foreach(_name README.md manifest.schema.json THIRD_PARTY_NOTICES.txt verify.py bundle.py)
    set(_from "${_cli_common}")
    if(_name STREQUAL "README.md" OR _name STREQUAL "manifest.schema.json")
      set(_from "${CLI_MATERIALS}")
    endif()
    install(FILES "${_from}/${_name}" DESTINATION "${_cli_share}" COMPONENT ${CLI_NAME})
    list(APPEND _cli_payload "${_cli_share}/${_name}")
  endforeach()
  foreach(_dir IN LISTS CLI_EXAMPLES)
    file(GLOB _examples CONFIGURE_DEPENDS "${_dir}/*")
    foreach(_file IN LISTS _examples)
      get_filename_component(_name "${_file}" NAME)
      install(FILES "${_file}" DESTINATION "${_cli_share}/examples" COMPONENT ${CLI_NAME})
      list(APPEND _cli_payload "${_cli_share}/examples/${_name}")
    endforeach()
  endforeach()
  foreach(_list _cli_payload _cli_executables)
    set(_normalized "")
    foreach(_path IN LISTS ${_list})
      _dft_cli_normal_path("${_path}" _path)
      list(APPEND _normalized "${_path}")
    endforeach()
    list(REMOVE_DUPLICATES _normalized)
    list(SORT _normalized)
    set(${_list} "${_normalized}")
  endforeach()
  set(_cli_sanitized false)
  if(HIER_SANITIZE OR DFT_SANITIZE)
    set(_cli_sanitized true)
  endif()
  set(_script "${CMAKE_CURRENT_BINARY_DIR}/${CLI_NAME}Manifest")
  string(HEX "${CMAKE_SYSTEM_NAME}" _cli_system_hex)
  string(HEX "${CMAKE_SYSTEM_PROCESSOR}" _cli_processor_hex)
  file(READ "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/Text.cmake" _cli_text_helpers)
  configure_file("${CMAKE_CURRENT_FUNCTION_LIST_DIR}/Manifest.cmake.in" "${_script}.in.cmake" @ONLY)
  file(GENERATE OUTPUT "${_script}-$<CONFIG>.cmake" INPUT "${_script}.in.cmake")
  install(SCRIPT "${_script}-$<CONFIG>.cmake" COMPONENT ${CLI_NAME})
endfunction()
