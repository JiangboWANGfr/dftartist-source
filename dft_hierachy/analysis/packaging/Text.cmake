# One implementation is used at configure time and embedded in generated manifests.
function(_dft_cli_validate_text value label)
  string(HEX "${value}" _hex)
  string(LENGTH "${_hex}" _length)
  set(_offset 0)
  set(_remaining 0)
  set(_minimum 128)
  set(_maximum 191)
  while(_offset LESS _length)
    string(SUBSTRING "${_hex}" ${_offset} 2 _pair)
    math(EXPR _byte "0x${_pair}")
    math(EXPR _offset "${_offset} + 2")
    if(_remaining GREATER 0)
      if(_byte LESS _minimum OR _byte GREATER _maximum)
        message(FATAL_ERROR "CLI ${label} must be valid UTF-8")
      endif()
      math(EXPR _scalar "${_scalar} * 64 + ${_byte} - 128")
      math(EXPR _remaining "${_remaining} - 1")
      set(_minimum 128)
      set(_maximum 191)
    elseif(_byte LESS 128)
      set(_scalar ${_byte})
    elseif(_byte GREATER_EQUAL 194 AND _byte LESS_EQUAL 223)
      math(EXPR _scalar "${_byte} & 31")
      set(_remaining 1)
    elseif(_byte GREATER_EQUAL 224 AND _byte LESS_EQUAL 239)
      math(EXPR _scalar "${_byte} & 15")
      set(_remaining 2)
      if(_byte EQUAL 224)
        set(_minimum 160)
      elseif(_byte EQUAL 237)
        set(_maximum 159)
      endif()
    elseif(_byte GREATER_EQUAL 240 AND _byte LESS_EQUAL 244)
      math(EXPR _scalar "${_byte} & 7")
      set(_remaining 3)
      if(_byte EQUAL 240)
        set(_minimum 144)
      elseif(_byte EQUAL 244)
        set(_maximum 143)
      endif()
    else()
      message(FATAL_ERROR "CLI ${label} must be valid UTF-8")
    endif()
    if(_remaining EQUAL 0 AND (_scalar LESS 32 OR (_scalar GREATER_EQUAL 127 AND _scalar LESS_EQUAL 159)))
      message(FATAL_ERROR "CLI ${label} must not contain control characters")
    endif()
  endwhile()
  if(NOT _remaining EQUAL 0)
    message(FATAL_ERROR "CLI ${label} must be valid UTF-8")
  endif()
endfunction()

# Metadata is embedded as hex so quotes, backslashes and CMake-looking text
# remain data when configure_file produces executable install scripts.
function(_dft_cli_unhex hex output)
  string(LENGTH "${hex}" _length)
  set(_offset 0)
  set(_text "")
  while(_offset LESS _length)
    string(SUBSTRING "${hex}" ${_offset} 2 _pair)
    math(EXPR _byte "0x${_pair}")
    string(ASCII ${_byte} _character)
    string(APPEND _text "${_character}")
    math(EXPR _offset "${_offset} + 2")
  endwhile()
  set(${output} "${_text}" PARENT_SCOPE)
endfunction()
