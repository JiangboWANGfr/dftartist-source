@_cli_text_helpers@

function(_cli_quote value output)
  _dft_cli_validate_text("${value}" "manifest string")
  string(REPLACE "\\" "\\\\" _s "${value}")
  string(REPLACE "\"" "\\\"" _s "${_s}")
  string(REPLACE "\n" "\\n" _s "${_s}")
  string(REPLACE "\r" "\\r" _s "${_s}")
  string(REPLACE "\t" "\\t" _s "${_s}")
  set(${output} "\"${_s}\"" PARENT_SCOPE)
endfunction()
set(_cli_root "$ENV{DESTDIR}${CMAKE_INSTALL_PREFIX}")
set(_cli_payload "@_cli_payload@")
set(_cli_executables "@_cli_executables@")
# Normalize after generator-expression expansion too; executable kind and file rows
# must use the same spelling as the installed filesystem paths.
foreach(_list _cli_payload _cli_executables)
  set(_normalized "")
  foreach(_path IN LISTS ${_list})
    cmake_path(NORMAL_PATH _path)
    string(REGEX REPLACE "/+$" "" _path "${_path}")
    list(APPEND _normalized "${_path}")
  endforeach()
  list(REMOVE_DUPLICATES _normalized)
  list(SORT _normalized)
  set(${_list} "${_normalized}")
endforeach()
_cli_quote("${CMAKE_INSTALL_CONFIG_NAME}" _config)
_dft_cli_unhex("@_cli_system_hex@" _system)
_dft_cli_unhex("@_cli_processor_hex@" _processor)
_cli_quote("${_system}" _system)
_cli_quote("${_processor}" _processor)
set(_json "{\n  \"formatVersion\": 1,\n  \"format\": \"@CLI_FORMAT@\",\n  \"kind\": \"@CLI_KIND@\",\n  \"configuration\": ${_config},\n  \"system\": ${_system},\n  \"processor\": ${_processor},\n  \"sanitized\": @_cli_sanitized@,\n  \"files\": [")
set(_comma "")
foreach(_rel IN LISTS _cli_payload)
  if(NOT EXISTS "${_cli_root}/${_rel}" OR IS_SYMLINK "${_cli_root}/${_rel}")
    message(FATAL_ERROR "@CLI_NAME@ payload missing or symlink: ${_rel}")
  endif()
  file(SHA256 "${_cli_root}/${_rel}" _hash)
  file(SIZE "${_cli_root}/${_rel}" _size)
  set(_kind data)
  list(FIND _cli_executables "${_rel}" _exe_index)
  if(_exe_index GREATER_EQUAL 0)
    set(_kind executable)
  endif()
  _cli_quote("${_rel}" _path)
  string(APPEND _json "${_comma}\n    {\"path\": ${_path}, \"bytes\": ${_size}, \"sha256\": \"${_hash}\", \"kind\": \"${_kind}\"}")
  set(_comma ",")
endforeach()
string(APPEND _json "\n  ]\n}\n")
file(WRITE "${_cli_root}/@_cli_share@/manifest.json" "${_json}")
