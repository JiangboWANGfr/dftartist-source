{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:dft-studio:wrapper-cli-manifest:1",
  "type": "object",
  "properties": {
    "formatVersion": {
      "type": "integer",
      "const": 1
    },
    "format": {
      "const": "wrapper-cli-manifest-v1"
    },
    "kind": {
      "const": "dft-wrapper-install"
    },
    "configuration": {
      "type": "string"
    },
    "system": {
      "type": "string"
    },
    "processor": {
      "type": "string"
    },
    "sanitized": {
      "type": "boolean"
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4096,
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "bytes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "kind": {
            "enum": [
              "executable",
              "data"
            ]
          }
        },
        "required": [
          "path",
          "bytes",
          "sha256",
          "kind"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "formatVersion",
    "format",
    "kind",
    "configuration",
    "system",
    "processor",
    "sanitized",
    "files"
  ],
  "additionalProperties": false
}
