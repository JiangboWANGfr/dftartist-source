{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:dft-studio:analysis:wrapper-chain-plan:1",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "formatVersion": {
          "const": 1
        },
        "algorithm": {
          "const": "rtl-wrapper-chain-plan-v1"
        },
        "source": {
          "$ref": "urn:dft-studio:analysis:wrapper-cell-plan:1#/oneOf/0"
        },
        "layout": {
          "type": "object",
          "properties": {
            "chains": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4096
                  },
                  "capacity": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 9007199254740991
                  },
                  "length": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "segments": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "kind": {
                          "enum": [
                            "dedicated",
                            "shared"
                          ]
                        },
                        "offset": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 9007199254740991
                        },
                        "length": {
                          "type": "integer",
                          "minimum": 1,
                          "maximum": 9007199254740991
                        },
                        "sourceRow": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 9007199254740991
                        },
                        "signal": {
                          "$ref": "urn:dft-studio:hier:protocol:2:schema:7#/$defs/ObjectRef"
                        },
                        "bits": {
                          "type": "object",
                          "properties": {
                            "lsb": {
                              "type": "integer",
                              "minimum": 0,
                              "maximum": 9007199254740991
                            },
                            "width": {
                              "type": "integer",
                              "minimum": 1,
                              "maximum": 9007199254740991
                            }
                          },
                          "required": [
                            "lsb",
                            "width"
                          ],
                          "additionalProperties": false
                        }
                      },
                      "required": [
                        "kind",
                        "offset",
                        "length",
                        "sourceRow"
                      ],
                      "additionalProperties": false,
                      "allOf": [
                        {
                          "if": {
                            "properties": {
                              "kind": {
                                "const": "shared"
                              }
                            }
                          },
                          "then": {
                            "required": [
                              "signal",
                              "bits"
                            ]
                          },
                          "else": {
                            "properties": {
                              "signal": false,
                              "bits": false,
                              "length": {
                                "const": 1
                              }
                            }
                          }
                        }
                      ]
                    }
                  }
                },
                "required": [
                  "name",
                  "capacity",
                  "length",
                  "segments"
                ],
                "additionalProperties": false
              },
              "minItems": 1,
              "maxItems": 1024
            },
            "assignments": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "port": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4096
                  },
                  "direction": {
                    "enum": [
                      "input",
                      "output",
                      "both"
                    ]
                  },
                  "bits": {
                    "type": "object",
                    "properties": {
                      "lsb": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 9007199254740991
                      },
                      "width": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 9007199254740991
                      }
                    },
                    "required": [
                      "lsb",
                      "width"
                    ],
                    "additionalProperties": false
                  },
                  "chain": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4096
                  }
                },
                "required": [
                  "port",
                  "direction",
                  "chain"
                ],
                "additionalProperties": false
              },
              "maxItems": 10000
            },
            "defaultChain": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            },
            "limits": {
              "type": "object",
              "properties": {
                "maxRows": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 100000
                },
                "maxSegments": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 100000
                },
                "maxWork": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 10000000
                },
                "maxMillis": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 60000
                }
              },
              "required": [
                "maxRows",
                "maxSegments",
                "maxWork",
                "maxMillis"
              ],
              "additionalProperties": false
            },
            "complete": {
              "type": "boolean"
            },
            "work": {
              "type": "integer",
              "minimum": 0,
              "maximum": 10000000
            },
            "reasons": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "rows": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "sourceRow": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "assignment": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "chain": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 1023
                  },
                  "status": {
                    "enum": [
                      "placed",
                      "excluded",
                      "blocked"
                    ]
                  },
                  "reason": {
                    "enum": [
                      "allocated",
                      "excluded",
                      "source_blocked",
                      "unassigned",
                      "capacity",
                      "chain_conflict"
                    ]
                  },
                  "newBits": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "reusedBits": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "uses": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "segment": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 9007199254740991
                        },
                        "offset": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 9007199254740991
                        },
                        "width": {
                          "type": "integer",
                          "minimum": 1,
                          "maximum": 9007199254740991
                        }
                      },
                      "required": [
                        "segment",
                        "offset",
                        "width"
                      ],
                      "additionalProperties": false
                    }
                  }
                },
                "required": [
                  "sourceRow",
                  "status",
                  "reason",
                  "newBits",
                  "reusedBits",
                  "uses"
                ],
                "additionalProperties": false,
                "allOf": [
                  {
                    "if": {
                      "properties": {
                        "status": {
                          "const": "placed"
                        }
                      }
                    },
                    "then": {
                      "required": [
                        "chain"
                      ],
                      "properties": {
                        "reason": {
                          "const": "allocated"
                        },
                        "uses": {
                          "minItems": 1
                        }
                      }
                    },
                    "else": {
                      "properties": {
                        "newBits": {
                          "const": 0
                        },
                        "reusedBits": {
                          "const": 0
                        },
                        "uses": {
                          "maxItems": 0
                        }
                      }
                    }
                  },
                  {
                    "if": {
                      "properties": {
                        "status": {
                          "const": "excluded"
                        }
                      }
                    },
                    "then": {
                      "properties": {
                        "reason": {
                          "const": "excluded"
                        }
                      }
                    }
                  },
                  {
                    "if": {
                      "properties": {
                        "status": {
                          "const": "blocked"
                        }
                      }
                    },
                    "then": {
                      "properties": {
                        "reason": {
                          "enum": [
                            "source_blocked",
                            "unassigned",
                            "capacity",
                            "chain_conflict"
                          ]
                        }
                      }
                    }
                  }
                ]
              },
              "maxItems": 100000
            },
            "counts": {
              "type": "object",
              "properties": {
                "rows": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "placed": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "excluded": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "blocked": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "dedicatedBits": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "sharedBits": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "reusedBits": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "totalBits": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                }
              },
              "required": [
                "rows",
                "placed",
                "excluded",
                "blocked",
                "dedicatedBits",
                "sharedBits",
                "reusedBits",
                "totalBits"
              ],
              "additionalProperties": false
            },
            "unusedAssignments": {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              }
            },
            "stop": {
              "type": "object",
              "properties": {
                "reason": {
                  "enum": [
                    "budget_rows",
                    "budget_segments",
                    "budget_work",
                    "budget_time"
                  ]
                },
                "sourceRow": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                }
              },
              "required": [
                "reason",
                "sourceRow"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "chains",
            "assignments",
            "limits",
            "complete",
            "work",
            "reasons",
            "rows",
            "counts",
            "unusedAssignments"
          ],
          "additionalProperties": false,
          "allOf": [
            {
              "if": {
                "properties": {
                  "complete": {
                    "const": true
                  }
                }
              },
              "then": {
                "properties": {
                  "reasons": {
                    "maxItems": 0
                  },
                  "unusedAssignments": {
                    "maxItems": 0
                  },
                  "counts": {
                    "properties": {
                      "blocked": {
                        "const": 0
                      }
                    }
                  },
                  "stop": false
                }
              },
              "else": {
                "properties": {
                  "reasons": {
                    "minItems": 1
                  }
                }
              }
            }
          ]
        }
      },
      "required": [
        "formatVersion",
        "algorithm",
        "source",
        "layout"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "layout": {
                "properties": {
                  "complete": {
                    "const": true
                  }
                }
              }
            }
          },
          "then": {
            "properties": {
              "source": {
                "properties": {
                  "plan": {
                    "properties": {
                      "complete": {
                        "const": true
                      }
                    }
                  }
                }
              }
            }
          }
        }
      ]
    },
    {
      "$ref": "urn:dft-studio:analysis:wrapper-boundary:1#/oneOf/1"
    }
  ]
}
