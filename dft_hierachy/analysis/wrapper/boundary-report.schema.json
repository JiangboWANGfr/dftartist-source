{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:dft-studio:analysis:wrapper-boundary:1",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "formatVersion": {
          "const": 1
        },
        "algorithm": {
          "const": "rtl-wrapper-boundary-v1"
        },
        "snapshot": {
          "$ref": "urn:dft-studio:hier:protocol:2:schema:7#/$defs/SnapshotInfo"
        },
        "scope": {
          "$ref": "urn:dft-studio:hier:protocol:2:schema:7#/$defs/InstInfo"
        },
        "request": {
          "type": "object",
          "properties": {
            "scope": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            },
            "ports": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096
              },
              "maxItems": 10000,
              "uniqueItems": true
            },
            "limits": {
              "type": "object",
              "properties": {
                "maxPorts": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 100000
                },
                "maxBits": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 100000
                },
                "maxWork": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 10000000
                },
                "maxDepth": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 256
                },
                "maxMillis": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 60000
                },
                "pageSize": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 1000
                }
              },
              "required": [
                "maxPorts",
                "maxBits",
                "maxWork",
                "maxDepth",
                "maxMillis",
                "pageSize"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "scope",
            "ports",
            "limits"
          ],
          "additionalProperties": false
        },
        "complete": {
          "type": "boolean"
        },
        "work": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000000
        },
        "reasons": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "ports": {
          "type": "array",
          "items": {
            "$ref": "urn:dft-studio:hier:protocol:2:schema:7#/$defs/PortInfo"
          },
          "maxItems": 100000
        },
        "unsupportedPorts": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "rows": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "port": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "bit": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "upstream": {
                "type": "boolean"
              },
              "complete": {
                "type": "boolean"
              },
              "hasConservative": {
                "type": "boolean"
              },
              "summary": {
                "enum": [
                  "register",
                  "control",
                  "boundary",
                  "constant",
                  "unconnected",
                  "dangling",
                  "mixed",
                  "unknown"
                ]
              },
              "reasons": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "steps": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "point": {
                      "$ref": "urn:dft-studio:hier:protocol:2:schema:7#/$defs/TracePoint"
                    },
                    "response": {
                      "type": "object",
                      "properties": {
                        "result": {
                          "$ref": "urn:dft-studio:hier:protocol:2:schema:7#/$defs/StepResult"
                        },
                        "completeness": {
                          "$ref": "urn:dft-studio:hier:protocol:2:schema:7#/$defs/Completeness"
                        }
                      },
                      "required": [
                        "result",
                        "completeness"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "required": [
                    "point",
                    "response"
                  ],
                  "additionalProperties": false
                }
              },
              "terminals": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "enum": [
                        "register_output",
                        "register_data",
                        "register_control",
                        "register_async",
                        "boundary",
                        "const",
                        "unconnected",
                        "opaque",
                        "dangling",
                        "register_clock"
                      ]
                    },
                    "step": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    },
                    "hop": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    },
                    "continuation": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    }
                  },
                  "required": [
                    "kind",
                    "step"
                  ],
                  "additionalProperties": false,
                  "allOf": [
                    {
                      "if": {
                        "properties": {
                          "kind": {
                            "const": "dangling"
                          }
                        },
                        "required": [
                          "kind"
                        ]
                      },
                      "then": {
                        "properties": {
                          "hop": false,
                          "continuation": false
                        }
                      },
                      "else": {
                        "required": [
                          "hop"
                        ]
                      }
                    },
                    {
                      "if": {
                        "properties": {
                          "kind": {
                            "enum": [
                              "register_data",
                              "register_control",
                              "register_async",
                              "register_clock"
                            ]
                          }
                        },
                        "required": [
                          "kind"
                        ]
                      },
                      "then": {
                        "required": [
                          "continuation"
                        ]
                      }
                    }
                  ]
                }
              },
              "processes": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "step",
                    "hop",
                    "response"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "step": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "hop": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "response": {
                      "type": "object",
                      "required": [
                        "result",
                        "completeness"
                      ],
                      "additionalProperties": false,
                      "properties": {
                        "result": {
                          "$ref": "urn:dft-studio:hier:protocol:2:schema:7#/$defs/ProcessInfo"
                        },
                        "completeness": {
                          "$ref": "urn:dft-studio:hier:protocol:2:schema:7#/$defs/Completeness"
                        }
                      }
                    }
                  }
                }
              }
            },
            "required": [
              "port",
              "bit",
              "upstream",
              "complete",
              "hasConservative",
              "summary",
              "reasons",
              "steps",
              "terminals",
              "processes"
            ],
            "additionalProperties": false,
            "allOf": [
              {
                "if": {
                  "properties": {
                    "complete": {
                      "const": true
                    }
                  }
                },
                "then": {
                  "properties": {
                    "reasons": {
                      "maxItems": 0
                    },
                    "summary": {
                      "not": {
                        "const": "unknown"
                      }
                    },
                    "hasConservative": {
                      "const": false
                    }
                  }
                },
                "else": {
                  "properties": {
                    "reasons": {
                      "minItems": 1
                    },
                    "summary": {
                      "const": "unknown"
                    }
                  }
                }
              }
            ]
          },
          "maxItems": 100000
        },
        "stop": {
          "type": "object",
          "properties": {
            "reason": {
              "enum": [
                "budget_ports",
                "budget_bits",
                "budget_work",
                "budget_depth",
                "budget_time"
              ]
            },
            "port": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "bit": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "upstream": {
              "type": "boolean"
            }
          },
          "required": [
            "reason"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "formatVersion",
        "algorithm",
        "snapshot",
        "scope",
        "request",
        "complete",
        "work",
        "reasons",
        "ports",
        "unsupportedPorts",
        "rows"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "complete": {
                "const": true
              }
            }
          },
          "then": {
            "properties": {
              "reasons": {
                "maxItems": 0
              },
              "unsupportedPorts": {
                "maxItems": 0
              },
              "stop": false,
              "rows": {
                "items": {
                  "properties": {
                    "complete": {
                      "const": true
                    }
                  }
                }
              }
            }
          },
          "else": {
            "properties": {
              "reasons": {
                "minItems": 1
              }
            }
          }
        }
      ]
    },
    {
      "type": "object",
      "properties": {
        "formatVersion": {
          "const": 1
        },
        "error": {
          "type": "object",
          "properties": {
            "code": {
              "enum": [
                "invalid_arguments",
                "not_found",
                "cancelled",
                "analysis_failed",
                "design_invalid",
                "output_failed"
              ]
            },
            "message": {
              "type": "string"
            }
          },
          "required": [
            "code",
            "message"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "formatVersion",
        "error"
      ],
      "additionalProperties": false
    }
  ]
}
