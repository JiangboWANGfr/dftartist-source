{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:dft-studio:analysis:wrapper-cell-plan:1",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "formatVersion": {
          "const": 1
        },
        "algorithm": {
          "const": "rtl-wrapper-cell-plan-v1"
        },
        "source": {
          "$ref": "urn:dft-studio:analysis:wrapper-boundary:1#/oneOf/0"
        },
        "plan": {
          "type": "object",
          "properties": {
            "policy": {
              "type": "object",
              "properties": {
                "maxInputCandidates": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 1000000
                },
                "maxOutputCandidates": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 1000000
                }
              },
              "required": [
                "maxInputCandidates",
                "maxOutputCandidates"
              ],
              "additionalProperties": false
            },
            "rules": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "port": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4096
                  },
                  "direction": {
                    "enum": [
                      "input",
                      "output",
                      "both"
                    ]
                  },
                  "action": {
                    "enum": [
                      "exclude",
                      "dedicated",
                      "share"
                    ]
                  },
                  "bits": {
                    "type": "object",
                    "properties": {
                      "lsb": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 9007199254740991
                      },
                      "width": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 9007199254740991
                      }
                    },
                    "required": [
                      "lsb",
                      "width"
                    ],
                    "additionalProperties": false
                  }
                },
                "required": [
                  "port",
                  "direction",
                  "action"
                ],
                "additionalProperties": false
              },
              "maxItems": 10000
            },
            "limits": {
              "type": "object",
              "properties": {
                "maxRows": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 100000
                },
                "maxWork": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 10000000
                },
                "maxMillis": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 60000
                }
              },
              "required": [
                "maxRows",
                "maxWork",
                "maxMillis"
              ],
              "additionalProperties": false
            },
            "complete": {
              "type": "boolean"
            },
            "work": {
              "type": "integer",
              "minimum": 0,
              "maximum": 10000000
            },
            "reasons": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "rows": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "sourceRow": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "rule": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "decision": {
                    "enum": [
                      "excluded",
                      "dedicated",
                      "shared_candidate",
                      "blocked"
                    ]
                  },
                  "reason": {
                    "enum": [
                      "declared_exclude",
                      "declared_dedicated",
                      "evidence_partial",
                      "control_usage",
                      "non_data_path",
                      "no_register_candidate",
                      "candidate_limit",
                      "data_candidates"
                    ]
                  },
                  "candidateBits": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "candidates": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "signal": {
                          "$ref": "urn:dft-studio:hier:protocol:2:schema:7#/$defs/ObjectRef"
                        },
                        "ranges": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "lsb": {
                                "type": "integer",
                                "minimum": 0,
                                "maximum": 9007199254740991
                              },
                              "width": {
                                "type": "integer",
                                "minimum": 1,
                                "maximum": 9007199254740991
                              }
                            },
                            "required": [
                              "lsb",
                              "width"
                            ],
                            "additionalProperties": false
                          }
                        },
                        "bits": {
                          "type": "integer",
                          "minimum": 1,
                          "maximum": 9007199254740991
                        },
                        "terminals": {
                          "type": "array",
                          "items": {
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 9007199254740991
                          }
                        }
                      },
                      "required": [
                        "signal",
                        "ranges",
                        "bits",
                        "terminals"
                      ],
                      "additionalProperties": false
                    }
                  }
                },
                "required": [
                  "sourceRow",
                  "decision",
                  "reason",
                  "candidateBits",
                  "candidates"
                ],
                "additionalProperties": false,
                "allOf": [
                  {
                    "if": {
                      "properties": {
                        "decision": {
                          "const": "shared_candidate"
                        }
                      }
                    },
                    "then": {
                      "properties": {
                        "reason": {
                          "const": "data_candidates"
                        },
                        "candidateBits": {
                          "type": "integer",
                          "minimum": 1,
                          "maximum": 9007199254740991
                        },
                        "candidates": {
                          "minItems": 1
                        }
                      }
                    }
                  },
                  {
                    "if": {
                      "properties": {
                        "decision": {
                          "const": "excluded"
                        }
                      }
                    },
                    "then": {
                      "required": [
                        "rule"
                      ],
                      "properties": {
                        "reason": {
                          "const": "declared_exclude"
                        }
                      }
                    }
                  }
                ]
              },
              "maxItems": 100000
            },
            "sharedSignals": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "signal": {
                    "$ref": "urn:dft-studio:hier:protocol:2:schema:7#/$defs/ObjectRef"
                  },
                  "ranges": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "lsb": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 9007199254740991
                        },
                        "width": {
                          "type": "integer",
                          "minimum": 1,
                          "maximum": 9007199254740991
                        }
                      },
                      "required": [
                        "lsb",
                        "width"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "bits": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 9007199254740991
                  },
                  "rows": {
                    "type": "array",
                    "items": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    }
                  }
                },
                "required": [
                  "signal",
                  "ranges",
                  "bits",
                  "rows"
                ],
                "additionalProperties": false
              }
            },
            "counts": {
              "type": "object",
              "properties": {
                "inputRows": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "outputRows": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "excluded": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "dedicated": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "sharedCandidate": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "blocked": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "sharedCandidateBits": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "uniqueSharedBits": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "addedCells": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                }
              },
              "required": [
                "inputRows",
                "outputRows",
                "excluded",
                "dedicated",
                "sharedCandidate",
                "blocked",
                "sharedCandidateBits",
                "uniqueSharedBits",
                "addedCells"
              ],
              "additionalProperties": false
            },
            "unusedRules": {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              }
            },
            "stop": {
              "type": "object",
              "properties": {
                "reason": {
                  "enum": [
                    "budget_rows",
                    "budget_work",
                    "budget_time"
                  ]
                },
                "sourceRow": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                }
              },
              "required": [
                "reason",
                "sourceRow"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "policy",
            "rules",
            "limits",
            "complete",
            "work",
            "reasons",
            "rows",
            "sharedSignals",
            "counts",
            "unusedRules"
          ],
          "additionalProperties": false,
          "allOf": [
            {
              "if": {
                "properties": {
                  "complete": {
                    "const": true
                  }
                }
              },
              "then": {
                "properties": {
                  "reasons": {
                    "maxItems": 0
                  },
                  "unusedRules": {
                    "maxItems": 0
                  },
                  "counts": {
                    "properties": {
                      "blocked": {
                        "const": 0
                      }
                    }
                  },
                  "stop": false
                }
              },
              "else": {
                "properties": {
                  "reasons": {
                    "minItems": 1
                  }
                }
              }
            }
          ]
        }
      },
      "required": [
        "formatVersion",
        "algorithm",
        "source",
        "plan"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "plan": {
                "properties": {
                  "complete": {
                    "const": true
                  }
                }
              }
            }
          },
          "then": {
            "properties": {
              "source": {
                "properties": {
                  "complete": {
                    "const": true
                  }
                }
              }
            }
          }
        }
      ]
    },
    {
      "$ref": "urn:dft-studio:analysis:wrapper-boundary:1#/oneOf/1"
    }
  ]
}
