{
  "type": "object",
  "properties": {
    "formatVersion": {
      "const": 1,
      "type": "integer"
    },
    "kind": {
      "const": "wrapper-config"
    },
    "mode": {
      "enum": [
        "boundary",
        "cells",
        "chains"
      ]
    },
    "boundary": {
      "$ref": "#/$defs/boundary"
    },
    "planning": {
      "$ref": "#/$defs/planning"
    },
    "chaining": {
      "$ref": "#/$defs/chaining"
    }
  },
  "required": [
    "formatVersion",
    "kind",
    "mode",
    "boundary"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dft-studio.local/wrapper-config.schema.json",
  "$defs": {
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^[^\\u0000]+$"
    },
    "bits": {
      "type": "object",
      "properties": {
        "lsb": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "width": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "lsb",
        "width"
      ],
      "additionalProperties": false
    },
    "boundaryLimits": {
      "type": "object",
      "properties": {
        "maxPorts": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000
        },
        "maxBits": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000
        },
        "maxWork": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000000
        },
        "maxDepth": {
          "type": "integer",
          "minimum": 1,
          "maximum": 256
        },
        "maxMillis": {
          "type": "integer",
          "minimum": 1,
          "maximum": 60000
        },
        "pageSize": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "planLimits": {
      "type": "object",
      "properties": {
        "maxRows": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000
        },
        "maxWork": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000000
        },
        "maxMillis": {
          "type": "integer",
          "minimum": 1,
          "maximum": 60000
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "chainLimits": {
      "type": "object",
      "properties": {
        "maxRows": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000
        },
        "maxSegments": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000
        },
        "maxWork": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000000
        },
        "maxMillis": {
          "type": "integer",
          "minimum": 1,
          "maximum": 60000
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "rule": {
      "type": "object",
      "properties": {
        "port": {
          "$ref": "#/$defs/text"
        },
        "direction": {
          "enum": [
            "input",
            "output",
            "both"
          ]
        },
        "action": {
          "enum": [
            "exclude",
            "dedicated",
            "share"
          ]
        },
        "bits": {
          "$ref": "#/$defs/bits"
        }
      },
      "required": [
        "port",
        "direction",
        "action"
      ],
      "additionalProperties": false
    },
    "assignment": {
      "type": "object",
      "properties": {
        "port": {
          "$ref": "#/$defs/text"
        },
        "direction": {
          "enum": [
            "input",
            "output",
            "both"
          ]
        },
        "chain": {
          "$ref": "#/$defs/text"
        },
        "bits": {
          "$ref": "#/$defs/bits"
        }
      },
      "required": [
        "port",
        "direction",
        "chain"
      ],
      "additionalProperties": false
    },
    "chain": {
      "type": "object",
      "properties": {
        "name": {
          "$ref": "#/$defs/text"
        },
        "capacity": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "name",
        "capacity"
      ],
      "additionalProperties": false
    },
    "boundary": {
      "type": "object",
      "properties": {
        "scope": {
          "$ref": "#/$defs/text"
        },
        "ports": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/text"
          },
          "minItems": 0,
          "maxItems": 10000,
          "uniqueItems": true
        },
        "limits": {
          "$ref": "#/$defs/boundaryLimits"
        }
      },
      "required": [
        "scope"
      ],
      "additionalProperties": false
    },
    "planning": {
      "type": "object",
      "properties": {
        "policy": {
          "type": "object",
          "properties": {
            "maxInputCandidates": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000000
            },
            "maxOutputCandidates": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000000
            }
          },
          "required": [],
          "additionalProperties": false
        },
        "limits": {
          "$ref": "#/$defs/planLimits"
        },
        "rules": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/rule"
          },
          "minItems": 0,
          "maxItems": 10000
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "chaining": {
      "type": "object",
      "properties": {
        "chains": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/chain"
          },
          "minItems": 1,
          "maxItems": 1024
        },
        "assignments": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/assignment"
          },
          "minItems": 0,
          "maxItems": 10000
        },
        "defaultChain": {
          "$ref": "#/$defs/text"
        },
        "limits": {
          "$ref": "#/$defs/chainLimits"
        }
      },
      "required": [
        "chains"
      ],
      "additionalProperties": false
    }
  },
  "oneOf": [
    {
      "properties": {
        "mode": {
          "const": "boundary"
        }
      },
      "not": {
        "anyOf": [
          {
            "required": [
              "planning"
            ]
          },
          {
            "required": [
              "chaining"
            ]
          }
        ]
      }
    },
    {
      "properties": {
        "mode": {
          "const": "cells"
        }
      },
      "not": {
        "required": [
          "chaining"
        ]
      }
    },
    {
      "properties": {
        "mode": {
          "const": "chains"
        }
      },
      "required": [
        "chaining"
      ]
    }
  ]
}
