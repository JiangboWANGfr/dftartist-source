{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:dft-studio:analysis:library-memory:1",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "formatVersion": {
          "const": 1
        },
        "algorithm": {
          "const": "rtl-library-memory-v1"
        },
        "library": {
          "type": "object",
          "properties": {
            "source": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096,
              "pattern": "^[^\\u0000]*$"
            },
            "cells": {
              "type": "array",
              "minItems": 1,
              "maxItems": 256,
              "items": {
                "type": "object",
                "properties": {
                  "definitionName": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4096,
                    "pattern": "^[^\\u0000]*$"
                  },
                  "cell": {
                    "type": "object",
                    "properties": {
                      "pins": {
                        "type": "array",
                        "minItems": 1,
                        "maxItems": 256,
                        "items": {
                          "type": "object",
                          "properties": {
                            "name": {
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 4096,
                              "pattern": "^[^\\u0000]*$"
                            },
                            "direction": {
                              "enum": [
                                "in",
                                "out",
                                "inout",
                                "ref",
                                "unknown"
                              ]
                            },
                            "width": {
                              "type": "integer",
                              "minimum": 1,
                              "maximum": 65536
                            },
                            "attrs": {
                              "type": "object",
                              "maxProperties": 32,
                              "propertyNames": {
                                "type": "string",
                                "minLength": 1,
                                "maxLength": 256,
                                "pattern": "^[^\\u0000]*$"
                              },
                              "additionalProperties": {
                                "type": "string",
                                "maxLength": 4096,
                                "pattern": "^[^\\u0000]*$"
                              }
                            }
                          },
                          "required": [
                            "name",
                            "direction",
                            "width",
                            "attrs"
                          ],
                          "additionalProperties": false
                        }
                      },
                      "attrs": {
                        "type": "object",
                        "maxProperties": 33,
                        "propertyNames": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 256,
                          "pattern": "^[^\\u0000]*$"
                        },
                        "additionalProperties": {
                          "type": "string",
                          "maxLength": 4096,
                          "pattern": "^[^\\u0000]*$"
                        },
                        "required": [
                          "dft.library.source"
                        ]
                      }
                    },
                    "required": [
                      "pins",
                      "attrs"
                    ],
                    "additionalProperties": false
                  }
                },
                "required": [
                  "definitionName",
                  "cell"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "source",
            "cells"
          ],
          "additionalProperties": false
        },
        "analysis": {
          "oneOf": [
            {
              "$ref": "urn:dft-studio:analysis:macro-interfaces:1#/oneOf/0"
            },
            {
              "$ref": "urn:dft-studio:analysis:memory-map:1#/oneOf/0"
            }
          ]
        }
      },
      "required": [
        "formatVersion",
        "algorithm",
        "library",
        "analysis"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "formatVersion": {
          "const": 1
        },
        "error": {
          "type": "object",
          "properties": {
            "code": {
              "enum": [
                "invalid_arguments",
                "not_found",
                "cancelled",
                "analysis_failed",
                "design_invalid",
                "output_failed"
              ]
            },
            "message": {
              "type": "string"
            }
          },
          "required": [
            "code",
            "message"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "formatVersion",
        "error"
      ],
      "additionalProperties": false
    }
  ]
}
