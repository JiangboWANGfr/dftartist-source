{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:dft-studio:analysis:memory-test-plan:1",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "formatVersion": {
          "const": 1
        },
        "algorithm": {
          "const": "rtl-memory-test-plan-v1"
        },
        "investigation": {
          "$ref": "urn:dft-studio:analysis:memory-map:1#/oneOf/0"
        },
        "plan": {
          "type": "object",
          "properties": {
            "request": {
              "type": "object",
              "properties": {
                "profiles": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "definitionName": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 4096,
                        "pattern": "^[^\\u0000]*$"
                      },
                      "operationsPerWord": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 1024
                      },
                      "powerMicrowatts": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 1000000000000
                      }
                    },
                    "required": [
                      "definitionName",
                      "operationsPerWord",
                      "powerMicrowatts"
                    ],
                    "additionalProperties": false
                  },
                  "minItems": 1,
                  "maxItems": 256
                },
                "assignments": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "instancePath": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 4096,
                        "pattern": "^[^\\u0000]*$"
                      },
                      "clockDomain": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 4096,
                        "pattern": "^[^\\u0000]*$"
                      },
                      "partition": {
                        "type": "string",
                        "minLength": 0,
                        "maxLength": 4096,
                        "pattern": "^[^\\u0000]*$"
                      }
                    },
                    "required": [
                      "instancePath",
                      "clockDomain",
                      "partition"
                    ],
                    "additionalProperties": false
                  },
                  "minItems": 0,
                  "maxItems": 10000
                },
                "policy": {
                  "type": "object",
                  "properties": {
                    "maxMemoriesPerController": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 1024
                    },
                    "maxParallelMemories": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 1024
                    },
                    "maxPowerMicrowatts": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 1000000000000
                    }
                  },
                  "required": [
                    "maxMemoriesPerController",
                    "maxParallelMemories",
                    "maxPowerMicrowatts"
                  ],
                  "additionalProperties": false
                },
                "limits": {
                  "type": "object",
                  "properties": {
                    "maxControllers": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 10000
                    },
                    "maxWork": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 10000000
                    },
                    "maxMillis": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 60000
                    }
                  },
                  "required": [
                    "maxControllers",
                    "maxWork",
                    "maxMillis"
                  ],
                  "additionalProperties": false
                }
              },
              "required": [
                "profiles",
                "assignments",
                "policy",
                "limits"
              ],
              "additionalProperties": false
            },
            "complete": {
              "type": "boolean"
            },
            "reasons": {
              "type": "array",
              "items": {
                "enum": [
                  "mapping_partial",
                  "interface_unmatched",
                  "domain_missing",
                  "power_exceeded",
                  "budget_controllers",
                  "budget_work",
                  "budget_time",
                  "unused_assignments"
                ]
              },
              "uniqueItems": true
            },
            "work": {
              "type": "integer",
              "minimum": 0,
              "maximum": 10000
            },
            "visitedMemories": {
              "type": "integer",
              "minimum": 0,
              "maximum": 10000
            },
            "scheduledInstances": {
              "type": "integer",
              "minimum": 0,
              "maximum": 10000
            },
            "scheduledCapacityBits": {
              "oneOf": [
                {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                {
                  "type": "string",
                  "pattern": "^(0|[1-9][0-9]*)$"
                }
              ]
            },
            "unusedAssignments": {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9999
              },
              "uniqueItems": true,
              "maxItems": 10000
            },
            "memories": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "memory": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9999
                  },
                  "assignment": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9999
                  },
                  "controller": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9999
                  },
                  "step": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9999
                  },
                  "status": {
                    "enum": [
                      "scheduled",
                      "blocked"
                    ]
                  },
                  "reason": {
                    "enum": [
                      "",
                      "interface_unmatched",
                      "domain_missing",
                      "power_exceeded"
                    ]
                  }
                },
                "required": [
                  "memory",
                  "status",
                  "reason"
                ],
                "additionalProperties": false,
                "allOf": [
                  {
                    "if": {
                      "properties": {
                        "status": {
                          "const": "scheduled"
                        }
                      }
                    },
                    "then": {
                      "required": [
                        "assignment",
                        "controller",
                        "step"
                      ],
                      "properties": {
                        "reason": {
                          "const": ""
                        }
                      }
                    },
                    "else": {
                      "not": {
                        "anyOf": [
                          {
                            "required": [
                              "controller"
                            ]
                          },
                          {
                            "required": [
                              "step"
                            ]
                          }
                        ]
                      },
                      "properties": {
                        "reason": {
                          "enum": [
                            "interface_unmatched",
                            "domain_missing",
                            "power_exceeded"
                          ]
                        }
                      }
                    }
                  }
                ]
              },
              "minItems": 0,
              "maxItems": 10000
            },
            "controllers": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "model": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 255
                  },
                  "profile": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 255
                  },
                  "clockDomain": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4096,
                    "pattern": "^[^\\u0000]*$"
                  },
                  "partition": {
                    "type": "string",
                    "minLength": 0,
                    "maxLength": 4096,
                    "pattern": "^[^\\u0000]*$"
                  },
                  "reason": {
                    "enum": [
                      "compatibility_group",
                      "controller_capacity"
                    ]
                  },
                  "cycles": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 4503599627370496
                  },
                  "peakPowerMicrowatts": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 1000000000000
                  },
                  "steps": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "memories": {
                          "type": "array",
                          "items": {
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 9999
                          },
                          "minItems": 1,
                          "maxItems": 1024,
                          "uniqueItems": true
                        },
                        "reasons": {
                          "type": "array",
                          "items": {
                            "enum": [
                              "initial",
                              "parallel_limit",
                              "power_limit"
                            ]
                          },
                          "minItems": 1,
                          "maxItems": 2,
                          "uniqueItems": true
                        },
                        "cycles": {
                          "type": "integer",
                          "minimum": 1,
                          "maximum": 4398046511104
                        },
                        "powerMicrowatts": {
                          "type": "integer",
                          "minimum": 1,
                          "maximum": 1000000000000
                        }
                      },
                      "required": [
                        "memories",
                        "reasons",
                        "cycles",
                        "powerMicrowatts"
                      ],
                      "additionalProperties": false
                    },
                    "minItems": 1,
                    "maxItems": 1024
                  }
                },
                "required": [
                  "model",
                  "profile",
                  "clockDomain",
                  "partition",
                  "reason",
                  "cycles",
                  "peakPowerMicrowatts",
                  "steps"
                ],
                "additionalProperties": false
              },
              "minItems": 0,
              "maxItems": 10000
            }
          },
          "required": [
            "request",
            "complete",
            "reasons",
            "work",
            "visitedMemories",
            "scheduledInstances",
            "scheduledCapacityBits",
            "unusedAssignments",
            "memories",
            "controllers"
          ],
          "additionalProperties": false,
          "allOf": [
            {
              "if": {
                "properties": {
                  "complete": {
                    "const": true
                  }
                }
              },
              "then": {
                "properties": {
                  "reasons": {
                    "maxItems": 0
                  },
                  "unusedAssignments": {
                    "maxItems": 0
                  },
                  "memories": {
                    "items": {
                      "properties": {
                        "status": {
                          "const": "scheduled"
                        }
                      }
                    }
                  }
                }
              },
              "else": {
                "properties": {
                  "reasons": {
                    "minItems": 1
                  }
                }
              }
            }
          ]
        },
        "library": {
          "$ref": "urn:dft-studio:analysis:library-memory:1#/oneOf/0/properties/library"
        }
      },
      "required": [
        "formatVersion",
        "algorithm",
        "investigation",
        "plan"
      ],
      "additionalProperties": false
    },
    {
      "$ref": "urn:dft-studio:analysis:memory-map:1#/oneOf/1"
    }
  ]
}
