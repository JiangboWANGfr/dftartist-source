{
  "type": "object",
  "properties": {
    "formatVersion": {
      "const": 1
    },
    "kind": {
      "const": "memory-clock-expectations"
    },
    "domains": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "clockDomain": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096,
            "pattern": "^[^\\u0000]*$"
          },
          "sources": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4096,
                  "pattern": "^[^\\u0000]*$"
                },
                "bit": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "edge": {
                  "enum": [
                    "posedge",
                    "negedge"
                  ]
                }
              },
              "required": [
                "path",
                "bit",
                "edge"
              ],
              "additionalProperties": false
            },
            "minItems": 1,
            "maxItems": 256,
            "uniqueItems": true
          }
        },
        "required": [
          "clockDomain",
          "sources"
        ],
        "additionalProperties": false
      },
      "maxItems": 10000
    }
  },
  "required": [
    "formatVersion",
    "kind",
    "domains"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:dft-studio:analysis:memory-clock-expectations:1"
}
