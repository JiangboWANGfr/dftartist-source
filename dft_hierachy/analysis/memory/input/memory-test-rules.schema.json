{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:dft-studio:analysis:memory-test-rules-input:1",
  "type": "object",
  "properties": {
    "formatVersion": {
      "const": 1
    },
    "kind": {
      "const": "memory-test-rules"
    },
    "rules": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096,
              "pattern": "^[^\\u0000]*$"
            },
            "minItems": 1,
            "maxItems": 256
          },
          "recursive": {
            "type": "boolean"
          },
          "clockDomain": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096,
            "pattern": "^[^\\u0000]*$"
          },
          "partition": {
            "type": "string",
            "minLength": 0,
            "maxLength": 4096,
            "pattern": "^[^\\u0000]*$"
          }
        },
        "required": [
          "path",
          "recursive",
          "clockDomain",
          "partition"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 1024
    }
  },
  "required": [
    "formatVersion",
    "kind",
    "rules"
  ],
  "additionalProperties": false
}
